Процедура ПередЗаписью(Отказ)
	ПраваДокументации.ПроверитьЗапись(ЭтотОбъект);
	КонтрольВыпуска.ПроверитьЗависимость(Ссылка);

	КонтрольДокументации.ПроверитьИзменениеРедакции(ЭтотОбъект);
	НомерРедакции = СокрЛП(НомерРедакции);
	СсылкаНаТекст = СокрЛП(СсылкаНаТекст);
	ИдентификаторСодержимого = СокрЛП(ИдентификаторСодержимого);
	Если Не ЗначениеЗаполнено(ДокументПродукта) Тогда
		ВызватьИсключение "Выберите документ, к которому относится редакция.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НомерРедакции) Тогда
		ВызватьИсключение "Укажите номер редакции.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Автор) Тогда
		ВызватьИсключение "Укажите автора редакции.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СсылкаНаТекст) Тогда
		ВызватьИсключение "Укажите ссылку на текст редакции.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИдентификаторСодержимого) Тогда
		ВызватьИсключение "Укажите идентификатор содержимого редакции.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	| Редакции.Ссылка
	|ИЗ
	| Справочник.РедакцииДокументов КАК Редакции
	|ГДЕ
	| Редакции.ДокументПродукта = &Документ
	| И Редакции.НомерРедакции = &Номер
	| И Редакции.Ссылка <> &ТекущаяРедакция";
	Запрос.УстановитьПараметр("Документ", ДокументПродукта);
	Запрос.УстановитьПараметр("Номер", НомерРедакции);
	Запрос.УстановитьПараметр("ТекущаяРедакция", Ссылка);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Для этого документа уже существует редакция с таким номером. Откройте её или укажите другой номер.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = Строка(ДокументПродукта) + " / " + НомерРедакции;
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)
	ПраваДокументации.ПроверитьУдаление(ЭтотОбъект);
	КонтрольВыпуска.ПроверитьЗависимость(Ссылка);
КонецПроцедуры
