Процедура Убедиться(Условие, Текст)
	Если Не Условие Тогда ВызватьИсключение Текст; КонецЕсли;
КонецПроцедуры

Процедура СохранитьРезультат(Путь, Результат)
	Запись = Новый ЗаписьJSON; Запись.ОткрытьФайл(Путь); ЗаписатьJSON(Запись, Результат); Запись.Закрыть();
КонецПроцедуры

Функция Элемент(Менеджер, Код, Название, Поля)
	Убедиться(Менеджер.НайтиПоКоду(Код).Пустая(), "Занят код примера прав: " + Код);
	Объект = Менеджер.СоздатьЭлемент(); Объект.Код = Код; Объект.Наименование = Название;
	Для Каждого Поле Из Поля Цикл Объект[Поле.Ключ] = Поле.Значение; КонецЦикла;
	Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Функция НоваяРедакция(ДокументПродукта, Версия, Автор, ПапкаЗапуска)
	Объект = Справочники.РедакцииДокументов.СоздатьЭлемент();
	Объект.ДокументПродукта = ДокументПродукта; Объект.НомерРедакции = Версия; Объект.Автор = Автор;
	Путь = ПапкаЗапуска + "\examples\user-guide.md";
	Объект.СсылкаНаТекст = "file:///" + СтрЗаменить(Путь, "\", "/");
	Хеш = Новый ТекстовыйДокумент; Хеш.Прочитать(Путь + ".sha256");
	Объект.ИдентификаторСодержимого = СокрЛП(Хеш.ПолучитьТекст());
	Возврат Объект;
КонецФункции

Функция НоваяПередача(Редакция, Проверяющий, ДатаСобытия)
	Объект = Документы.ПередачаНаПроверку.СоздатьДокумент();
	Объект.Дата = ДатаСобытия; Объект.Редакция = Редакция; Объект.Проверяющий = Проверяющий;
	Возврат Объект;
КонецФункции

Функция НовоеРешение(Передача, Проверяющий)
	Объект = Документы.РезультатПроверки.СоздатьДокумент(); Объект.Дата = Передача.Дата + 1;
	Объект.Передача = Передача; Объект.Проверяющий = Проверяющий;
	Объект.Решение = Перечисления.РешенияПроверки.Согласовано;
	Возврат Объект;
КонецФункции

Функция ДанныеПримера()
	Пример = Новый Структура;
	Пример.Вставить("Автор", Справочники.Сотрудники.НайтиПоКоду("AC-AUTHOR"));
	Пример.Вставить("Автор2", Справочники.Сотрудники.НайтиПоКоду("AC-AUTHOR2"));
	Пример.Вставить("Проверяющий", Справочники.Сотрудники.НайтиПоКоду("AC-REVIEWER"));
	Пример.Вставить("Проверяющий2", Справочники.Сотрудники.НайтиПоКоду("AC-REVIEWER2"));
	Пример.Вставить("Руководитель", Справочники.Сотрудники.НайтиПоКоду("AC-MANAGER"));
	Пример.Вставить("Продукт", Справочники.Продукты.НайтиПоКоду("AC-PRODUCT"));
	Пример.Вставить("Документ", Справочники.ДокументыПродуктов.НайтиПоКоду("AC-DOC-1"));
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, НомерРедакции ИЗ Справочник.РедакцииДокументов ГДЕ ДокументПродукта = &Документ");
	Запрос.УстановитьПараметр("Документ", Пример.Документ);
	Для Каждого СтрокаДанных Из Запрос.Выполнить().Выгрузить() Цикл
		Если СтрокаДанных.НомерРедакции = "2.0" Тогда Пример.Вставить("Черновая", СтрокаДанных.Ссылка);
		ИначеЕсли СтрокаДанных.НомерРедакции = "2.1" Тогда Пример.Вставить("ЧужаяЧерновая", СтрокаДанных.Ссылка);
		ИначеЕсли СтрокаДанных.НомерРедакции = "1.1" Тогда Пример.Вставить("НаПроверке", СтрокаДанных.Ссылка);
		ИначеЕсли СтрокаДанных.НомерРедакции = "1.2" Тогда Пример.Вставить("ЧужаяНаПроверке", СтрокаДанных.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Пример.Вставить("Передача", КонтрольДокументации.ПолучитьСостояние(Пример.НаПроверке).Передача);
	Пример.Вставить("ЧужаяПередача", КонтрольДокументации.ПолучитьСостояние(Пример.ЧужаяНаПроверке).Передача);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ПланКомплекта ГДЕ Продукт = &Продукт И НомерРелиза = &Релиз";
	Запрос.УстановитьПараметр("Продукт", Пример.Продукт); Запрос.УстановитьПараметр("Релиз", "AC-1.0");
	Пример.Вставить("План", Запрос.Выполнить().Выгрузить()[0].Ссылка);
	Возврат Пример;
КонецФункции

Процедура ПодготовитьПользователей(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска) Экспорт
	Информация = Новый СистемнаяИнформация;
	Результат = Новый Структура("phase,version,run_id,source_digest,platform_version,status,error,accounts",
		"milestone_7_roles_setup", "0.7.0-dev", ИдентификаторЗапуска, ХешИсходников, Информация.ВерсияПриложения, "FAIL", "", Новый Массив);
	Результат.Вставить("bootstrap", Новый Структура("login,user_id,administration_right,administrator_role", "", "", Ложь, Ложь));
	Попытка
		ПользовательСеанса = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ПользовательСеанса <> Неопределено Тогда
			Результат.bootstrap.login = ПользовательСеанса.Имя;
			Результат.bootstrap.user_id = Строка(ПользовательСеанса.УникальныйИдентификатор);
		КонецЕсли;
		Результат.bootstrap.administration_right = ПравоДоступа("Администрирование", Метаданные);
		Результат.bootstrap.administrator_role = РольДоступна("АдминистраторDocRelease");
		ПраваДокументации.ТребоватьАдминистратора();
		ПроверкиОтчетов.ЗапуститьПроверкиОтчетов(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска);
		Чтение = Новый ЧтениеJSON; Чтение.ОткрытьФайл(ПапкаЗапуска + "\accounts.json"); Список = ПрочитатьJSON(Чтение); Чтение.Закрыть();
		Для Каждого Описание Из Список Цикл
			Убедиться(ПользователиИнформационнойБазы.НайтиПоИмени(Описание.login) = Неопределено, "Проверочный пользователь уже существует.");
		КонецЦикла;
		Для Каждого Описание Из Список Цикл
			Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя();
			Пользователь.Имя = Описание.login; Пользователь.ПолноеИмя = Описание.name;
			Пользователь.АутентификацияСтандартная = Истина; Пользователь.ПоказыватьВСпискеВыбора = Истина;
			Пользователь.Роли.Добавить(Метаданные.Роли[Описание.role]); Пользователь.Записать();
			// Список назначений читается только в подготовительном сеансе администратора.
			НазначенныеРоли = Новый Массив;
			Для Каждого НазначеннаяРоль Из Пользователь.Роли Цикл
				НазначенныеРоли.Добавить(НазначеннаяРоль.Имя);
			КонецЦикла;
			Убедиться(НазначенныеРоли.Количество() = 1 И НазначенныеРоли[0] = Описание.role, "Сохранено неверное назначение роли пользователя.");
			Если ЗначениеЗаполнено(Описание.code) Тогда
				Элемент(Справочники.Сотрудники, Описание.code, Описание.name, Новый Структура("ИмяПользователяИБ", Описание.login));
			КонецЕсли;
			Результат.accounts.Добавить(Новый Структура("login,role,user_id,assigned_roles", Описание.login, Описание.role, Строка(Пользователь.УникальныйИдентификатор), НазначенныеРоли));
		КонецЦикла;
		Автор = Справочники.Сотрудники.НайтиПоКоду("AC-AUTHOR"); Автор2 = Справочники.Сотрудники.НайтиПоКоду("AC-AUTHOR2");
		Проверяющий = Справочники.Сотрудники.НайтиПоКоду("AC-REVIEWER"); Проверяющий2 = Справочники.Сотрудники.НайтиПоКоду("AC-REVIEWER2");
		Продукт = Элемент(Справочники.Продукты, "AC-PRODUCT", "DocRelease — пример прав", Новый Структура);
		Вид = Элемент(Справочники.ВидыДокументации, "AC-TYPE", "Документ проверки прав", Новый Структура);
		План = Документы.ПланКомплекта.СоздатьДокумент(); План.Дата = ТекущаяДата(); План.НомерРелиза = "AC-1.0";
		План.Продукт = Продукт; План.Куратор = Справочники.Сотрудники.НайтиПоКоду("AC-MANAGER");
		Момент = ТекущаяДата() - 600;
		Для Индекс = 1 По 3 Цикл
			ДокументПродукта = Элемент(Справочники.ДокументыПродуктов, "AC-DOC-" + Строка(Индекс), "Документ прав " + Строка(Индекс), Новый Структура("Продукт,ВидДокументации", Продукт, Вид));
			Редакция = НоваяРедакция(ДокументПродукта, "1.0", Автор, ПапкаЗапуска); Редакция.Записать();
			Передача = НоваяПередача(Редакция.Ссылка, Проверяющий, Момент); Передача.Записать(РежимЗаписиДокумента.Проведение);
			Решение = НовоеРешение(Передача.Ссылка, Проверяющий); Решение.Записать(РежимЗаписиДокумента.Проведение);
			СтрокаПлана = План.Документы.Добавить(); СтрокаПлана.ДокументПродукта = ДокументПродукта;
			СтрокаПлана.Редакция = Редакция.Ссылка; СтрокаПлана.Ответственный = Автор; СтрокаПлана.СрокПодготовки = НачалоДня(ТекущаяДата()) + 7 * 86400;
			Если Индекс = 1 Тогда
				Для Каждого Версия Из СтрРазделить("2.0|2.1|1.1|1.2", "|", Ложь) Цикл
					АвторРедакции = Автор; Назначенный = Проверяющий;
					Если Версия = "2.1" Или Версия = "1.2" Тогда АвторРедакции = Автор2; Назначенный = Проверяющий2; КонецЕсли;
					Редакция = НоваяРедакция(ДокументПродукта, Версия, АвторРедакции, ПапкаЗапуска); Редакция.Записать();
					Если Версия = "1.1" Или Версия = "1.2" Тогда
						Передача = НоваяПередача(Редакция.Ссылка, Назначенный, Момент); Передача.Записать(РежимЗаписиДокумента.Проведение);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		План.Записать(); Результат.status = "PASS";
	Исключение
		Результат.error = ОписаниеОшибки();
	КонецПопытки;
	СохранитьРезультат(ПапкаЗапуска + "\roles-setup.json", Результат);
КонецПроцедуры

Функция СценарииПользователя(Логин)
	Если Логин = "DRTEST_Admin" Тогда Возврат СтрРазделить("ID|ADMIN|BIND_DUP|BIND_UNKNOWN", "|", Ложь);
	ИначеЕсли Логин = "DRTEST_Author" Тогда Возврат СтрРазделить("ID|AUTHOR_NEW|AUTHOR_EDIT|AUTHOR_SPOOF|AUTHOR_FOREIGN|AUTHOR_TRANSFER|AUTHOR_FOREIGN_TRANSFER|DENY_REVIEW|DENY_PLAN|DENY_RELEASE|DENY_EMPLOYEE|DENY_REGISTER|DENY_USERS|REPORTS", "|", Ложь);
	ИначеЕсли Логин = "DRTEST_Author2" Тогда Возврат СтрРазделить("ID|AUTHOR2_EDIT", "|", Ложь);
	ИначеЕсли Логин = "DRTEST_Reviewer" Тогда Возврат СтрРазделить("ID|REVIEW_OWN|REVIEW_FOREIGN|REVIEW_SPOOF|DENY_EDITION|DENY_TRANSFER|DENY_PLAN|DENY_RELEASE|DENY_REGISTER|DENY_USERS|REPORTS", "|", Ложь);
	ИначеЕсли Логин = "DRTEST_Reviewer2" Тогда Возврат СтрРазделить("ID|REVIEW2_OWN", "|", Ложь);
	ИначеЕсли Логин = "DRTEST_Manager" Тогда Возврат СтрРазделить("ID|MANAGER_PLAN|MANAGER_RELEASE|DENY_EDITION|DENY_TRANSFER|DENY_REVIEW|DENY_EMPLOYEE|DENY_REGISTER|DENY_USERS|REPORTS", "|", Ложь);
	ИначеЕсли Логин = "DRTEST_Unmapped" Тогда Возврат СтрРазделить("UNMAPPED|UNMAPPED_WRITE|REPORTS", "|", Ложь);
	КонецЕсли;
	ВызватьИсключение "Этот пользователь не относится к проверочному примеру прав.";
КонецФункции

Процедура ОжидатьОтказЗаписи(Объект, ТекстПричины = "", Провести = Ложь)
	Сообщение = "";
	Попытка
		Если Провести Тогда Объект.Записать(РежимЗаписиДокумента.Проведение); Иначе Объект.Записать(); КонецЕсли;
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;
	Убедиться(Не ПустаяСтрока(Сообщение) И (ПустаяСтрока(ТекстПричины) Или СтрНайти(Сообщение, ТекстПричины) > 0), "Нет ожидаемого отказа записи: " + Сообщение);
КонецПроцедуры

Процедура ОжидатьПлатформенныйОтказСоздания(ИмяДокумента, Пример)
	// Платформа может отказать уже при СоздатьДокумент(), до вызова Записать().
	Сообщение = "";
	Попытка
		Если ИмяДокумента = "РезультатПроверки" Тогда
			Объект = НовоеРешение(Пример.Передача, Пример.Проверяющий);
			Объект.Записать();
		ИначеЕсли ИмяДокумента = "ВыпускКомплекта" Тогда
			Объект = Документы.ВыпускКомплекта.СоздатьДокумент();
			Объект.Дата = ТекущаяДата(); Объект.ПланКомплекта = Пример.План;
			Объект.Записать(РежимЗаписиДокумента.Проведение);
		ИначеЕсли ИмяДокумента = "ПередачаНаПроверку" Тогда
			Объект = НоваяПередача(Пример.Черновая, Пример.Проверяющий, ТекущаяДата());
			Объект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ВызватьИсключение "Неизвестная запрещённая операция создания документа.";
		КонецЕсли;
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;
	// Произвольная ошибка кода не считается подтверждением защиты.
	Убедиться(СтрНайти(Сообщение, "Нарушение прав доступа") > 0, "Нет ожидаемого платформенного отказа создания или записи: " + Сообщение);
КонецПроцедуры

Процедура ПроверитьСценарий(Код, Пример, Логин, ПапкаЗапуска)
	Если Код = "ID" Тогда
		Сотрудник = ПраваДокументации.ТекущийСотрудник();
		Убедиться(Сотрудник.ИмяПользователяИБ = Логин И Сотрудник.ИдентификаторПользователяИБ = Строка(ПользователиИнформационнойБазы.ТекущийПользователь().УникальныйИдентификатор), "Не совпал сотрудник сеанса.");
	ИначеЕсли Код = "ADMIN" Тогда
		Убедиться(ПраваДокументации.Администратор() И ПравоДоступа("Администрирование", Метаданные) И ПравоДоступа("Добавление", Метаданные.Документы.ВыпускКомплекта), "Нет прав администратора.");
	ИначеЕсли Код = "BIND_DUP" Или Код = "BIND_UNKNOWN" Тогда
		Объект = Справочники.Сотрудники.СоздатьЭлемент(); Объект.Наименование = "Проверка связи";
		Если Код = "BIND_DUP" Тогда Объект.ИмяПользователяИБ = "DRTEST_Author"; Причина = "уже связан";
		Иначе Объект.ИмяПользователяИБ = "DRTEST_NONEXISTENT"; Причина = "Не найден пользователь"; КонецЕсли;
		ОжидатьОтказЗаписи(Объект, Причина);
	ИначеЕсли Код = "AUTHOR_NEW" Тогда
		Редакция = НоваяРедакция(Пример.Документ, "AC-NEW", Пример.Автор, ПапкаЗапуска); Редакция.Записать();
		Убедиться(Редакция.Ссылка.Автор = Пример.Автор, "Не сохранилась своя редакция.");
	ИначеЕсли Код = "AUTHOR_EDIT" Или Код = "AUTHOR2_EDIT" Тогда
		Ссылка = Пример.Черновая; Если Код = "AUTHOR2_EDIT" Тогда Ссылка = Пример.ЧужаяЧерновая; КонецЕсли;
		Объект = Ссылка.ПолучитьОбъект(); Объект.Наименование = "Изменена своя редакция"; Объект.Записать();
		Убедиться(Ссылка.Наименование = "Изменена своя редакция", "Не изменилась своя редакция.");
	ИначеЕсли Код = "AUTHOR_SPOOF" Тогда
		Объект = НоваяРедакция(Пример.Документ, "AC-SPOOF", Пример.Автор2, ПапкаЗапуска); ОжидатьОтказЗаписи(Объект, "только свои редакции");
	ИначеЕсли Код = "AUTHOR_FOREIGN" Тогда
		Объект = Пример.ЧужаяЧерновая.ПолучитьОбъект(); Объект.Автор = Пример.Автор; ОжидатьОтказЗаписи(Объект, "только свои редакции");
	ИначеЕсли Код = "AUTHOR_TRANSFER" Тогда
		Объект = НоваяПередача(Пример.Черновая, Пример.Проверяющий, ТекущаяДата()); Объект.Записать(РежимЗаписиДокумента.Проведение);
		Убедиться(КонтрольДокументации.ПолучитьСостояние(Пример.Черновая).Передача = Объект.Ссылка, "Не записалось движение разрешённой передачи.");
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Убедиться(КонтрольДокументации.ПолучитьСостояние(Пример.Черновая) = Неопределено, "Не отменилось движение передачи.");
	ИначеЕсли Код = "AUTHOR_FOREIGN_TRANSFER" Тогда
		Объект = НоваяПередача(Пример.ЧужаяЧерновая, Пример.Проверяющий, ТекущаяДата()); ОжидатьОтказЗаписи(Объект, "только свои редакции", Истина);
	ИначеЕсли Код = "REVIEW_OWN" Или Код = "REVIEW2_OWN" Тогда
		Передача = Пример.Передача; Проверяющий = Пример.Проверяющий;
		Если Код = "REVIEW2_OWN" Тогда Передача = Пример.ЧужаяПередача; Проверяющий = Пример.Проверяющий2; КонецЕсли;
		Объект = НовоеРешение(Передача, Проверяющий); Объект.Записать(РежимЗаписиДокумента.Проведение);
		Убедиться(КонтрольДокументации.ПолучитьСостояние(Передача.Редакция).Состояние = Перечисления.СостоянияРедакции.Согласована, "Не согласована назначенная редакция.");
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Убедиться(КонтрольДокументации.ПолучитьСостояние(Передача.Редакция).Состояние = Перечисления.СостоянияРедакции.НаПроверке, "Не восстановилось состояние после отмены.");
	ИначеЕсли Код = "REVIEW_FOREIGN" Или Код = "REVIEW_SPOOF" Тогда
		Проверяющий = Пример.Проверяющий2; Если Код = "REVIEW_SPOOF" Тогда Проверяющий = Пример.Проверяющий; КонецЕсли;
		Объект = НовоеРешение(Пример.ЧужаяПередача, Проверяющий); ОжидатьОтказЗаписи(Объект, "назначенный проверяющий", Истина);
	ИначеЕсли Код = "MANAGER_PLAN" Тогда
		Объект = Пример.План.ПолучитьОбъект(); Объект.НомерРелиза = "AC-CHANGE"; Объект.Записать();
		Убедиться(Объект.Ссылка.НомерРелиза = "AC-CHANGE", "Не сохранился план руководителя.");
	ИначеЕсли Код = "MANAGER_RELEASE" Тогда
		Объект = Документы.ВыпускКомплекта.СоздатьДокумент(); Объект.Дата = ТекущаяДата(); Объект.ПланКомплекта = Пример.План;
		Объект.Записать(РежимЗаписиДокумента.Проведение); Убедиться(Объект.Документы.Количество() = 3, "Не сохранён состав выпуска.");
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	ИначеЕсли Код = "DENY_REVIEW" Тогда
		Убедиться(Не ПравоДоступа("Добавление", Метаданные.Документы.РезультатПроверки), "Ошибочно разрешено добавление решения.");
		ОжидатьПлатформенныйОтказСоздания("РезультатПроверки", Пример);
	ИначеЕсли Код = "DENY_PLAN" Тогда
		Убедиться(Не ПравоДоступа("Изменение", Метаданные.Документы.ПланКомплекта), "Ошибочно разрешено изменение плана.");
		Объект = Пример.План.ПолучитьОбъект(); Объект.НомерРелиза = "AC-DENY"; ОжидатьОтказЗаписи(Объект);
	ИначеЕсли Код = "DENY_RELEASE" Тогда
		Убедиться(Не ПравоДоступа("Добавление", Метаданные.Документы.ВыпускКомплекта), "Ошибочно разрешён выпуск.");
		ОжидатьПлатформенныйОтказСоздания("ВыпускКомплекта", Пример);
	ИначеЕсли Код = "DENY_EDITION" Тогда
		Убедиться(Не ПравоДоступа("Изменение", Метаданные.Справочники.РедакцииДокументов), "Ошибочно разрешено изменение редакции.");
		Объект = Пример.Черновая.ПолучитьОбъект(); Объект.Наименование = "Недопустимое изменение"; ОжидатьОтказЗаписи(Объект);
	ИначеЕсли Код = "DENY_TRANSFER" Тогда
		Убедиться(Не ПравоДоступа("Добавление", Метаданные.Документы.ПередачаНаПроверку), "Ошибочно разрешена передача.");
		ОжидатьПлатформенныйОтказСоздания("ПередачаНаПроверку", Пример);
	ИначеЕсли Код = "DENY_EMPLOYEE" Тогда
		Убедиться(Не ПравоДоступа("Изменение", Метаданные.Справочники.Сотрудники), "Ошибочно разрешено изменение связи сотрудника.");
		Объект = Пример.Автор.ПолучитьОбъект(); Объект.ИмяПользователяИБ = Логин; ОжидатьОтказЗаписи(Объект);
	ИначеЕсли Код = "DENY_REGISTER" Тогда
		Убедиться(Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.СостоянияРедакций), "Разрешена прямая запись истории.");
		Сообщение = "";
		Попытка
			Набор = РегистрыСведений.СостоянияРедакций.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Пример.Передача); Набор.Прочитать(); Набор.Записать();
		Исключение Сообщение = ОписаниеОшибки(); КонецПопытки;
		Убедиться(Не ПустаяСтрока(Сообщение), "Прямая запись истории не была отклонена.");
	ИначеЕсли Код = "DENY_USERS" Тогда
		Убедиться(Не ПравоДоступа("Администрирование", Метаданные), "Ошибочно предоставлено администрирование.");
		Сообщение = "";
		Попытка
			Пользователь = ПользователиИнформационнойБазы.СоздатьПользователя(); Пользователь.Имя = "AC_FORBIDDEN";
			Пользователь.АутентификацияСтандартная = Истина; Пользователь.Роли.Добавить(Метаданные.Роли.АдминистраторDocRelease); Пользователь.Записать();
		Исключение Сообщение = ОписаниеОшибки(); КонецПопытки;
		Убедиться(Не ПустаяСтрока(Сообщение), "Создание пользователя не было отклонено.");
	ИначеЕсли Код = "UNMAPPED" Тогда
		Сообщение = ""; Попытка Сотрудник = ПраваДокументации.ТекущийСотрудник(); Исключение Сообщение = ОписаниеОшибки(); КонецПопытки;
		Убедиться(СтрНайти(Сообщение, "связать пользователя") > 0, "Нет отказа для пользователя без связи.");
	ИначеЕсли Код = "UNMAPPED_WRITE" Тогда
		Объект = НоваяРедакция(Пример.Документ, "AC-UNMAPPED", Пример.Автор, ПапкаЗапуска); ОжидатьОтказЗаписи(Объект, "связать пользователя");
	ИначеЕсли Код = "REPORTS" Тогда
		Убедиться(ГотовностьКомплектов.РассчитатьГотовность(Пример.План).Готов, "Недоступна готовность плана.");
		Таблица = Отчеты.ДокументыНаПроверке.Создать().СформироватьДляПараметров(Новый Структура("Продукт", Пример.Продукт));
		Убедиться(Таблица.ШиринаТаблицы > 2, "Не сформирована очередь под ролью.");
		Таблица = Отчеты.ИсторияРедакции.Создать().СформироватьДляПараметров(Новый Структура("Редакция", Пример.НаПроверке));
		Убедиться(Таблица.ШиринаТаблицы > 2, "Не сформирована история под ролью.");
	Иначе ВызватьИсключение "Неизвестный сценарий прав: " + Код;
	КонецЕсли;
КонецПроцедуры

Функция ОтпечатокДанных()
	Результат = "";
	Таблицы = "Справочник.Продукты|Справочник.ВидыДокументации|Справочник.Сотрудники|Справочник.ДокументыПродуктов|Справочник.РедакцииДокументов|Документ.ПередачаНаПроверку|Документ.РезультатПроверки|Документ.ПланКомплекта|Документ.ВыпускКомплекта";
	Для Каждого Таблица Из СтрРазделить(Таблицы, "|", Ложь) Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ " + Таблица + " УПОРЯДОЧИТЬ ПО Ссылка");
		Результат = Результат + ЗначениеВСтрокуВнутр(Запрос.Выполнить().Выгрузить());
	КонецЦикла;
	Для Каждого Таблица Из СтрРазделить("Документ.ПланКомплекта.Документы|Документ.ВыпускКомплекта.Документы", "|", Ложь) Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ " + Таблица + " УПОРЯДОЧИТЬ ПО Ссылка, НомерСтроки");
		Результат = Результат + ЗначениеВСтрокуВнутр(Запрос.Выполнить().Выгрузить());
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений.СостоянияРедакций УПОРЯДОЧИТЬ ПО Период, Регистратор, НомерСтроки");
	Возврат Результат + ЗначениеВСтрокуВнутр(Запрос.Выполнить().Выгрузить());
КонецФункции



Процедура ЗапуститьПодПользователем(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска) Экспорт
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Пользователь = Неопределено Тогда ВызватьИсключение "Испытания прав требуют входа под пользователем базы."; КонецЕсли;
	Логин = Пользователь.Имя; Сценарии = СценарииПользователя(Логин); Информация = Новый СистемнаяИнформация;
	Результат = Новый Структура("phase,version,run_id,source_digest,platform_version,login,user_id,status,tests,passed_count,failed_count,error",
		"milestone_7_roles_user", "0.7.0-dev", ИдентификаторЗапуска, ХешИсходников, Информация.ВерсияПриложения, Логин,
		Строка(Пользователь.УникальныйИдентификатор), "FAIL", Новый Массив, 0, 0, "");
	Попытка
		ОжидаемаяРоль = "АвторДокументации";
		Если Логин = "DRTEST_Admin" Тогда ОжидаемаяРоль = "АдминистраторDocRelease";
		ИначеЕсли Логин = "DRTEST_Reviewer" Или Логин = "DRTEST_Reviewer2" Тогда ОжидаемаяРоль = "ПроверяющийДокументации";
		ИначеЕсли Логин = "DRTEST_Manager" Тогда ОжидаемаяРоль = "РуководительВыпуска"; КонецЕсли;
		// В обычном сеансе проверяются доступные роли без чтения административного свойства пользователя.
		ДоступныеРоли = Новый Массив;
		Для Каждого РольМетаданных Из Метаданные.Роли Цикл
			Если РольДоступна(РольМетаданных) Тогда ДоступныеРоли.Добавить(РольМетаданных.Имя); КонецЕсли;
		КонецЦикла;
		Результат.Вставить("available_roles", ДоступныеРоли);
		Убедиться(ДоступныеРоли.Количество() = 1 И ДоступныеРоли[0] = ОжидаемаяРоль, "Доступна не та роль либо есть дополнительные роли.");
		Убедиться(ПраваДокументации.Администратор() = (Логин = "DRTEST_Admin"), "Неверно определены права администратора именованного сеанса.");
		Результат.Вставить("role", ОжидаемаяРоль);
		Пример = ДанныеПримера();
		Для Каждого Код Из Сценарии Цикл
			Проверка = Новый Структура("id,status,error", Код, "FAIL", ""); До = ОтпечатокДанных();
			Попытка
				НачатьТранзакцию(); ПроверитьСценарий(Код, Пример, Логин, ПапкаЗапуска);
				Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
				Убедиться(ОтпечатокДанных() = До, "После сценария прав изменились прикладные данные.");
				Проверка.status = "PASS"; Результат.passed_count = Результат.passed_count + 1;
			Исключение
				Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
				Проверка.error = ОписаниеОшибки(); Результат.failed_count = Результат.failed_count + 1;
			КонецПопытки;
			Результат.tests.Добавить(Проверка);
		КонецЦикла;
		Если Результат.failed_count = 0 Тогда Результат.status = "PASS"; КонецЕсли;
	Исключение
		Результат.error = ОписаниеОшибки(); Результат.failed_count = Результат.failed_count + 1;
	КонецПопытки;
	СохранитьРезультат(ПапкаЗапуска + "\roles-" + Логин + ".json", Результат);
КонецПроцедуры
