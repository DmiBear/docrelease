Функция НовыйРезультат(МоментПроверки)
	Возврат Новый Структура("Готов,ВсегоДокументов,ГотовоДокументов,Причины,Предупреждения,Строки,МоментПроверки",
		Ложь, 0, 0, Новый Массив, Новый Массив, Новый Массив, МоментПроверки);
КонецФункции

Процедура ДобавитьПричину(Результат, СтрокаРезультата, Код, Текст)
	НомерСтроки = 0;
	ДокументПродукта = Справочники.ДокументыПродуктов.ПустаяСсылка();
	Если СтрокаРезультата <> Неопределено Тогда
		НомерСтроки = СтрокаРезультата.НомерСтроки;
		ДокументПродукта = СтрокаРезультата.ДокументПродукта;
		СтрокаРезультата.Причины.Добавить(Текст);
		СтрокаРезультата.Готова = Ложь;
	КонецЕсли;
	Результат.Причины.Добавить(Новый Структура("НомерСтроки,ДокументПродукта,Код,Текст", НомерСтроки, ДокументПродукта, Код, Текст));
КонецПроцедуры

// Сравнение применяется к данным, прочитанным сервером, а не к тексту из формы.
Функция СовпадаетПроверенныйТекст(Редакция, Передача) Экспорт
	Возврат Не ПустаяСтрока(СокрЛП(Редакция.СсылкаНаТекст))
		И Не ПустаяСтрока(СокрЛП(Редакция.ИдентификаторСодержимого))
		И Редакция.СсылкаНаТекст = Передача.СсылкаНаТекст
		И Редакция.ИдентификаторСодержимого = Передача.ИдентификаторСодержимого;
КонецФункции

Процедура ПроверитьСогласование(Результат, СтрокаРезультата, Редакция)
	Состояние = КонтрольДокументации.ПолучитьСостояние(Редакция.Ссылка);
	Если Состояние = Неопределено Тогда
		СтрокаРезультата.Состояние = "Не передана на проверку";
		ДобавитьПричину(Результат, СтрокаРезультата, "REVIEW_NOT_STARTED", "Выбранная редакция не передана на проверку.");
		Возврат;
	КонецЕсли;
	Если Состояние.Состояние = Перечисления.СостоянияРедакции.НаПроверке Тогда
		СтрокаРезультата.Состояние = "На проверке";
		ДобавитьПричину(Результат, СтрокаРезультата, "REVIEW_PENDING", "Проверка выбранной редакции ещё не завершена.");
		Возврат;
	КонецЕсли;
	Если Состояние.Состояние = Перечисления.СостоянияРедакции.НаДоработке Тогда
		СтрокаРезультата.Состояние = "На доработке";
		ДобавитьПричину(Результат, СтрокаРезультата, "REVIEW_REJECTED", "Выбранная редакция возвращена на доработку.");
		Возврат;
	КонецЕсли;
	Если Состояние.Состояние <> Перечисления.СостоянияРедакции.Согласована Тогда
		СтрокаРезультата.Состояние = "Состояние не определено";
		ДобавитьПричину(Результат, СтрокаРезультата, "REVIEW_STATE_UNKNOWN", "Не удалось определить действующее согласование редакции.");
		Возврат;
	КонецЕсли;
	СтрокаРезультата.Состояние = "Согласована";
	Если ТипЗнч(Состояние.Регистратор) <> Тип("ДокументСсылка.РезультатПроверки")
		Или Не ЗначениеЗаполнено(Состояние.Передача) Тогда
		ДобавитьПричину(Результат, СтрокаРезультата, "APPROVAL_INVALID", "Не найдено основание согласования выбранной редакции.");
		Возврат;
	КонецЕсли;
	Решение = Состояние.Регистратор.ПолучитьОбъект();
	Передача = Состояние.Передача.ПолучитьОбъект();
	Если Не Решение.Проведен Или Решение.ПометкаУдаления
		Или Не Передача.Проведен Или Передача.ПометкаУдаления
		Или Решение.Решение <> Перечисления.РешенияПроверки.Согласовано
		Или Решение.Передача <> Передача.Ссылка
		Или Передача.Редакция <> Редакция.Ссылка
		Или Решение.Проверяющий <> Передача.Проверяющий
		Или Состояние.Проверяющий <> Решение.Проверяющий
		Или Решение.Дата <> Состояние.Период Или Решение.Дата <= Передача.Дата Тогда
		ДобавитьПричину(Результат, СтрокаРезультата, "APPROVAL_INVALID", "Основание согласования не соответствует выбранной редакции и текущей проверке.");
	КонецЕсли;
	Если Не СовпадаетПроверенныйТекст(Редакция, Передача) Тогда
		ДобавитьПричину(Результат, СтрокаРезультата, "SNAPSHOT_CHANGED", "Ссылка или идентификатор текста отличаются от переданных на проверку.");
	КонецЕсли;
КонецПроцедуры

// Отдельная функция позволяет повторить тот же алгоритм внутри будущего выпуска.
// Она ничего не записывает в информационную базу.
Функция РассчитатьПоДаннымПлана(План, МоментПроверки = Неопределено) Экспорт
	Если МоментПроверки = Неопределено Тогда
		МоментПроверки = ТекущаяДата();
	КонецЕсли;
	Результат = НовыйРезультат(МоментПроверки);
	Если Не ЗначениеЗаполнено(План.Продукт) Тогда
		ДобавитьПричину(Результат, Неопределено, "PLAN_PRODUCT_REQUIRED", "В плане не указан продукт.");
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(План.НомерРелиза)) Тогда
		ДобавитьПричину(Результат, Неопределено, "RELEASE_NUMBER_REQUIRED", "В плане не указан номер релиза.");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(План.Куратор) Тогда
		ДобавитьПричину(Результат, Неопределено, "CURATOR_REQUIRED", "В плане не указан куратор.");
	КонецЕсли;
	Результат.ВсегоДокументов = План.Документы.Количество();
	Если Результат.ВсегоДокументов = 0 Тогда
		ДобавитьПричину(Результат, Неопределено, "EMPTY_PLAN", "Обязательный состав комплекта пуст.");
	КонецЕсли;
	ВключённыеДокументы = Новый Соответствие;
	Для Каждого СтрокаПлана Из План.Документы Цикл
		СтрокаРезультата = Новый Структура("НомерСтроки,ДокументПродукта,Редакция,Ответственный,СрокПодготовки,Состояние,Готова,Причины,Предупреждения",
			СтрокаПлана.НомерСтроки, СтрокаПлана.ДокументПродукта, СтрокаПлана.Редакция,
			СтрокаПлана.Ответственный, СтрокаПлана.СрокПодготовки, "Не выбрана редакция", Истина, Новый Массив, Новый Массив);
		Результат.Строки.Добавить(СтрокаРезультата);
		Если Не ЗначениеЗаполнено(СтрокаПлана.ДокументПродукта) Тогда
			ДобавитьПричину(Результат, СтрокаРезультата, "DOCUMENT_REQUIRED", "Не указан обязательный документ.");
		Иначе
			Если СтрокаПлана.ДокументПродукта.ПометкаУдаления Тогда
				ДобавитьПричину(Результат, СтрокаРезультата, "DOCUMENT_DELETED", "Документ помечен на удаление.");
			КонецЕсли;
			Если СтрокаПлана.ДокументПродукта.Продукт <> План.Продукт Тогда
				ДобавитьПричину(Результат, СтрокаРезультата, "WRONG_PRODUCT", "Документ относится к другому продукту.");
			КонецЕсли;
			Если ВключённыеДокументы.Получить(СтрокаПлана.ДокументПродукта) <> Неопределено Тогда
				ДобавитьПричину(Результат, СтрокаРезультата, "DUPLICATE_DOCUMENT", "Документ включён в план повторно.");
			КонецЕсли;
			ВключённыеДокументы.Вставить(СтрокаПлана.ДокументПродукта, Истина);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПлана.Ответственный) Тогда
			ДобавитьПричину(Результат, СтрокаРезультата, "OWNER_REQUIRED", "Не указан ответственный за документ.");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПлана.СрокПодготовки) Тогда
			ДобавитьПричину(Результат, СтрокаРезультата, "DEADLINE_REQUIRED", "Не указан срок подготовки документа.");
		ИначеЕсли НачалоДня(СтрокаПлана.СрокПодготовки) < НачалоДня(МоментПроверки) Тогда
			Текст = "Плановый срок " + Формат(СтрокаПлана.СрокПодготовки, "ДФ=dd.MM.yyyy") + " уже прошёл.";
			СтрокаРезультата.Предупреждения.Добавить(Текст);
			Результат.Предупреждения.Добавить(Новый Структура("НомерСтроки,Текст", СтрокаПлана.НомерСтроки, Текст));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПлана.Редакция) Тогда
			ДобавитьПричину(Результат, СтрокаРезультата, "REVISION_REQUIRED", "Не выбрана редакция документа.");
		Иначе
			Редакция = СтрокаПлана.Редакция.ПолучитьОбъект();
			Если Редакция.ПометкаУдаления Тогда
				ДобавитьПричину(Результат, СтрокаРезультата, "REVISION_DELETED", "Выбранная редакция помечена на удаление.");
			КонецЕсли;
			Если Редакция.ДокументПродукта <> СтрокаПлана.ДокументПродукта Тогда
				ДобавитьПричину(Результат, СтрокаРезультата, "WRONG_REVISION_DOCUMENT", "Выбранная редакция относится к другому документу.");
			КонецЕсли;
			Если Редакция.ДокументПродукта.Продукт <> План.Продукт Тогда
				ДобавитьПричину(Результат, СтрокаРезультата, "WRONG_REVISION_PRODUCT", "Выбранная редакция относится к другому продукту.");
			КонецЕсли;
			Если ПустаяСтрока(СокрЛП(Редакция.СсылкаНаТекст)) Тогда
				ДобавитьПричину(Результат, СтрокаРезультата, "TEXT_LINK_REQUIRED", "У редакции не указана ссылка на текст.");
			КонецЕсли;
			Если ПустаяСтрока(СокрЛП(Редакция.ИдентификаторСодержимого)) Тогда
				ДобавитьПричину(Результат, СтрокаРезультата, "CONTENT_ID_REQUIRED", "У редакции не указан идентификатор содержимого.");
			КонецЕсли;
			ПроверитьСогласование(Результат, СтрокаРезультата, Редакция);
		КонецЕсли;
		Если СтрокаРезультата.Готова Тогда
			Результат.ГотовоДокументов = Результат.ГотовоДокументов + 1;
		КонецЕсли;
	КонецЦикла;
	Результат.Готов = Результат.ВсегоДокументов > 0 И Результат.Причины.Количество() = 0;
	Возврат Результат;
КонецФункции

Функция РассчитатьГотовность(ПланСсылка) Экспорт
	Если Не ЗначениеЗаполнено(ПланСсылка) Тогда
		Результат = НовыйРезультат(ТекущаяДата());
		ДобавитьПричину(Результат, Неопределено, "PLAN_REQUIRED", "Сначала сохраните план комплекта.");
		Возврат Результат;
	КонецЕсли;
	Возврат РассчитатьПоДаннымПлана(ПланСсылка.ПолучитьОбъект());
КонецФункции

Функция СформироватьОтчёт(ПланСсылка) Экспорт
	Оценка = РассчитатьГотовность(ПланСсылка);
	Таблица = Новый ТабличныйДокумент;
	Таблица.ОтображатьСетку = Ложь;
	Таблица.ТолькоПросмотр = Истина;
	Таблица.АвтоМасштаб = Истина;
	Ширины = Новый Массив;
	Ширины.Добавить(5); Ширины.Добавить(38); Ширины.Добавить(15); Ширины.Добавить(24);
	Ширины.Добавить(30); Ширины.Добавить(15); Ширины.Добавить(56);
	Для Колонка = 1 По 7 Цикл
		Таблица.Область(1, Колонка).ШиринаКолонки = Ширины[Колонка - 1];
	КонецЦикла;
	Таблица.Область(1, 1, 1, 7).Объединить();
	Таблица.Область(1, 1).Текст = "Готовность комплекта документации";
	Таблица.Область(1, 1).Шрифт = Новый Шрифт("Arial", 14, Истина);
	Таблица.Область(2, 1, 2, 7).Объединить();
	Таблица.Область(2, 1).Текст = Строка(ПланСсылка);
	Таблица.Область(3, 1, 3, 7).Объединить();
	Таблица.Область(3, 1).Текст = "По сохранённым данным плана. Проверено: " + Формат(Оценка.МоментПроверки, "ДФ=dd.MM.yyyy HH:mm:ss");
	Таблица.Область(4, 1, 4, 7).Объединить();
	Если Оценка.Готов Тогда
		Таблица.Область(4, 1).Текст = "КОМПЛЕКТ ГОТОВ";
		Таблица.Область(4, 1, 4, 7).ЦветФона = Новый Цвет(220, 240, 225);
	Иначе
		Таблица.Область(4, 1).Текст = "КОМПЛЕКТ НЕ ГОТОВ";
		Таблица.Область(4, 1, 4, 7).ЦветФона = Новый Цвет(255, 235, 215);
	КонецЕсли;
	Таблица.Область(5, 1, 5, 7).Объединить();
	Таблица.Область(5, 1).Текст = "Готово документов: " + Строка(Оценка.ГотовоДокументов) + " из " + Строка(Оценка.ВсегоДокументов)
		+ ". Причин неготовности: " + Строка(Оценка.Причины.Количество()) + ". Предупреждений о сроках: " + Строка(Оценка.Предупреждения.Количество()) + ".";
	Заголовки = СтрРазделить("№|Документ|Редакция|Состояние|Ответственный|Срок|Причины неготовности", "|", Ложь);
	Для Колонка = 1 По 7 Цикл
		Таблица.Область(7, Колонка).Текст = Заголовки[Колонка - 1];
	КонецЦикла;
	Таблица.Область(7, 1, 7, 7).Шрифт = Новый Шрифт("Arial", 10, Истина);
	Таблица.Область(7, 1, 7, 7).ЦветФона = Новый Цвет(225, 235, 245);
	Номер = 8;
	Для Каждого Запись Из Оценка.Строки Цикл
		Таблица.Область(Номер, 1).Текст = Строка(Запись.НомерСтроки);
		Таблица.Область(Номер, 2).Текст = Строка(Запись.ДокументПродукта);
		Если ЗначениеЗаполнено(Запись.Редакция) Тогда
			Таблица.Область(Номер, 3).Текст = Запись.Редакция.НомерРедакции;
		КонецЕсли;
		Таблица.Область(Номер, 4).Текст = Запись.Состояние;
		Таблица.Область(Номер, 5).Текст = Строка(Запись.Ответственный);
		Таблица.Область(Номер, 6).Текст = Формат(Запись.СрокПодготовки, "ДФ=dd.MM.yyyy");
		Таблица.Область(Номер, 7).Текст = СтрСоединить(Запись.Причины, Символы.ПС);
		Таблица.Область(Номер, 1, Номер, 7).ВысотаСтроки = 45;
		Номер = Номер + 1;
	КонецЦикла;
	Номер = Номер + 1;
	Таблица.Область(Номер, 1, Номер, 7).Объединить();
	Таблица.Область(Номер, 1).Текст = "Полный перечень причин неготовности";
	Для Каждого Причина Из Оценка.Причины Цикл
		Номер = Номер + 1;
		Таблица.Область(Номер, 1, Номер, 7).Объединить();
		Префикс = "План: ";
		Если Причина.НомерСтроки > 0 Тогда
			Префикс = "Строка " + Строка(Причина.НомерСтроки) + " (" + Строка(Причина.ДокументПродукта) + "): ";
		КонецЕсли;
		Таблица.Область(Номер, 1).Текст = Префикс + Причина.Текст;
	КонецЦикла;
	Если Оценка.Причины.Количество() = 0 Тогда
		Номер = Номер + 1;
		Таблица.Область(Номер, 1, Номер, 7).Объединить();
		Таблица.Область(Номер, 1).Текст = "Причин неготовности нет.";
	КонецЕсли;
	Для Каждого Предупреждение Из Оценка.Предупреждения Цикл
		Номер = Номер + 1;
		Таблица.Область(Номер, 1, Номер, 7).Объединить();
		Таблица.Область(Номер, 1).Текст = "Срок, строка " + Строка(Предупреждение.НомерСтроки) + ": " + Предупреждение.Текст;
	КонецЦикла;
	Возврат Таблица;
КонецФункции
