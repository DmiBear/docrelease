// Запросы берутся из тех же макетов, которыми пользуются формы отчётов.
// Отчёты читают только действующие проведённые события, без записи данных.
Функция СхемаОтчета(ИмяОтчета) Экспорт
	Если ИмяОтчета = "ДокументыНаПроверке" Тогда
		Возврат Отчеты.ДокументыНаПроверке.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	ИначеЕсли ИмяОтчета = "ИсторияРедакции" Тогда
		Возврат Отчеты.ИсторияРедакции.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КонецЕсли;
	ВызватьИсключение "Неизвестный отчёт.";
КонецФункции

Функция НормализоватьПараметры(ИмяОтчета, Параметры) Экспорт
	Результат = Новый Структура;
	Если ИмяОтчета = "ДокументыНаПроверке" Тогда
		Результат.Вставить("Продукт", Справочники.Продукты.ПустаяСсылка());
		Результат.Вставить("Проверяющий", Справочники.Сотрудники.ПустаяСсылка());
	ИначеЕсли ИмяОтчета = "ИсторияРедакции" Тогда
		Результат.Вставить("Редакция", Справочники.РедакцииДокументов.ПустаяСсылка());
	Иначе
		ВызватьИсключение "Неизвестный отчёт.";
	КонецЕсли;
	Если Параметры <> Неопределено Тогда
		Для Каждого Элемент Из Параметры Цикл
			Если Не Результат.Свойство(Элемент.Ключ) Тогда
				ВызватьИсключение "Неизвестный параметр отчёта: " + Элемент.Ключ;
			КонецЕсли;
			Если Элемент.Значение <> Неопределено Тогда Результат[Элемент.Ключ] = Элемент.Значение; КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Элемент Из Результат Цикл
		Если ТипЗнч(Элемент.Значение) <> ТипЗнч(ПустоеЗначениеПараметра(Элемент.Ключ)) Тогда
			ВызватьИсключение "Неверный тип параметра отчёта: " + Элемент.Ключ;
		КонецЕсли;
	КонецЦикла;
	Если ИмяОтчета = "ИсторияРедакции" И Не ЗначениеЗаполнено(Результат.Редакция) Тогда
		ВызватьИсключение "Выберите редакцию в настройках отчёта «История редакции».";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПустоеЗначениеПараметра(Имя)
	Если Имя = "Продукт" Тогда Возврат Справочники.Продукты.ПустаяСсылка(); КонецЕсли;
	Если Имя = "Проверяющий" Тогда Возврат Справочники.Сотрудники.ПустаяСсылка(); КонецЕсли;
	Возврат Справочники.РедакцииДокументов.ПустаяСсылка();
КонецФункции

Функция ПолучитьДанные(ИмяОтчета, Параметры = Неопределено) Экспорт
	Значения = НормализоватьПараметры(ИмяОтчета, Параметры);
	Схема = СхемаОтчета(ИмяОтчета);
	Запрос = Новый Запрос(Схема.НаборыДанных[0].Запрос);
	Для Каждого Элемент Из Значения Цикл Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение); КонецЦикла;
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция НастройкиПоПараметрам(ИмяОтчета, Параметры = Неопределено) Экспорт
	Значения = НормализоватьПараметры(ИмяОтчета, Параметры);
	Схема = СхемаОтчета(ИмяОтчета);
	// Поля и структура хранятся в именованном варианте макета.
	Настройки = Неопределено;
	Для Каждого Вариант Из Схема.ВариантыНастроек Цикл
		Если Вариант.Имя = "Основной" Тогда
			Настройки = Вариант.Настройки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Настройки = Неопределено Тогда
		ВызватьИсключение "В макете отчёта отсутствует вариант настроек «Основной».";
	КонецЕсли;
	Для Каждого Элемент Из Значения Цикл
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Возврат Настройки;
КонецФункции

Процедура СформироватьПоНастройкам(ИмяОтчета, Настройки, ДокументРезультат, ДанныеРасшифровки = Неопределено) Экспорт
	Если Настройки.Структура.Количество() = 0 Или Настройки.Выбор.Элементы.Количество() = 0 Тогда
		ВызватьИсключение "В настройках отчёта не выбраны поля или структура вывода.";
	КонецЕсли;
	// Проверяем именно настройки формы, включая пользовательские изменения параметров.
	Параметры = Новый Структура;
	Для Каждого Элемент Из Настройки.ПараметрыДанных.Элементы Цикл
		Имя = Строка(Элемент.Параметр);
		Если Имя = "Продукт" Или Имя = "Проверяющий" Или Имя = "Редакция" Тогда
			Значение = Неопределено;
			Если Элемент.Использование Тогда Значение = Элемент.Значение; КонецЕсли;
			Параметры.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;
	Значения = НормализоватьПараметры(ИмяОтчета, Параметры);
	Для Каждого Элемент Из Значения Цикл
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Схема = СхемаОтчета(ИмяОтчета);
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = Компоновщик.Выполнить(Схема, Настройки, ДанныеРасшифровки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, , ДанныеРасшифровки);
	ДокументРезультат.Очистить();
	Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	Вывод.УстановитьДокумент(ДокументРезультат); Вывод.Вывести(Процессор);
КонецПроцедуры
