Процедура Убедиться(Условие, Текст)
	Если Не Условие Тогда
		ВызватьИсключение Текст;
	КонецЕсли;
КонецПроцедуры

Функция НовыйЭлемент(Менеджер, Код, Название, Поля)
	Убедиться(Менеджер.НайтиПоКоду(Код).Пустая(), "Занят код проверочного примера: " + Код);
	Объект = Менеджер.СоздатьЭлемент(); Объект.Код = Код; Объект.Наименование = Название;
	Для Каждого Поле Из Поля Цикл
		Объект[Поле.Ключ] = Поле.Значение;
	КонецЦикла;
	Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Функция НоваяРедакция(ДокументПродукта, Версия, Пример, ИмяФайла)
	Редакция = Справочники.РедакцииДокументов.СоздатьЭлемент();
	Редакция.ДокументПродукта = ДокументПродукта; Редакция.НомерРедакции = Версия; Редакция.Автор = Пример.Автор;
	Путь = Пример.ПапкаЗапуска + "\examples\" + ИмяФайла;
	Редакция.СсылкаНаТекст = "file:///" + СтрЗаменить(Путь, "\", "/");
	ТекстХеша = Новый ТекстовыйДокумент; ТекстХеша.Прочитать(Путь + ".sha256");
	Редакция.ИдентификаторСодержимого = СокрЛП(ТекстХеша.ПолучитьТекст());
	Убедиться(СтрДлина(Редакция.ИдентификаторСодержимого) = 64, "Не найден хеш проверочного текста.");
	Редакция.Записать(); Возврат Редакция.Ссылка;
КонецФункции

Функция Передать(Редакция, Пример, Момент)
	Передача = Документы.ПередачаНаПроверку.СоздатьДокумент();
	Передача.Дата = Момент; Передача.Редакция = Редакция; Передача.Проверяющий = Пример.Проверяющий;
	Передача.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Возврат Передача.Ссылка;
КонецФункции

Функция Решить(Передача, РешениеПроверки, Момент, Замечание = "")
	Решение = Документы.РезультатПроверки.СоздатьДокумент(); Решение.Дата = Момент;
	Решение.Передача = Передача; Решение.Проверяющий = Передача.Проверяющий;
	Решение.Решение = РешениеПроверки; Решение.Замечание = Замечание;
	Решение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Возврат Решение.Ссылка;
КонецФункции

Функция НовыйПлан(Пример, ВсеСогласованы = Истина)
	План = Документы.ПланКомплекта.СоздатьДокумент(); План.Дата = ТекущаяДата();
	План.Продукт = Пример.Продукт; План.Куратор = Пример.Автор; План.НомерРелиза = "3.0";
	Для Индекс = 0 По 2 Цикл
		СтрокаПлана = План.Документы.Добавить(); СтрокаПлана.ДокументПродукта = Пример.Документы[Индекс];
		СтрокаПлана.Ответственный = Пример.Автор; СтрокаПлана.СрокПодготовки = НачалоДня(ТекущаяДата()) + 7 * 86400;
		Если ВсеСогласованы Тогда
			СтрокаПлана.Редакция = Пример.Согласованные[Индекс];
		КонецЕсли;
	КонецЦикла;
	Возврат План;
КонецФункции

Функция СоздатьПример(ПапкаЗапуска, Префикс)
	НачатьТранзакцию();
	Попытка
		Пример = Новый Структура("ПапкаЗапуска,Документы,Согласованные,Передачи,Решения", ПапкаЗапуска, Новый Массив, Новый Массив, Новый Массив, Новый Массив);
		Пример.Вставить("Продукт", НовыйЭлемент(Справочники.Продукты, Префикс + "-PRODUCT", "DocRelease — пример выпуска " + Префикс, Новый Структура));
		Пример.Вставить("ДругойПродукт", НовыйЭлемент(Справочники.Продукты, Префикс + "-OTHER", "Другой проверочный продукт", Новый Структура));
		Пример.Вставить("Автор", НовыйЭлемент(Справочники.Сотрудники, Префикс + "-AUTHOR", "Автор комплекта", Новый Структура));
		Пример.Вставить("Проверяющий", НовыйЭлемент(Справочники.Сотрудники, Префикс + "-REVIEWER", "Проверяющий комплекта", Новый Структура));
		Названия = СтрРазделить("Руководство пользователя|Инструкция установки|Описание изменений", "|", Ложь);
		Файлы = СтрРазделить("user-guide.md|installation.md|changelog.md", "|", Ложь);
		Пример.Вставить("Момент", ТекущаяДата() - 300);
		Для Индекс = 0 По 2 Цикл
			Вид = НовыйЭлемент(Справочники.ВидыДокументации, Префикс + "-TYPE-" + Строка(Индекс + 1), Названия[Индекс], Новый Структура);
			ДокументПродукта = НовыйЭлемент(Справочники.ДокументыПродуктов, Префикс + "-DOC-" + Строка(Индекс + 1), Названия[Индекс] + " — пример выпуска " + Префикс,
				Новый Структура("Продукт,ВидДокументации", Пример.Продукт, Вид));
			Пример.Документы.Добавить(ДокументПродукта);
			Редакция = НоваяРедакция(ДокументПродукта, "1.0", Пример, Файлы[Индекс]);
			Передача = Передать(Редакция, Пример, Пример.Момент);
			Решение = Решить(Передача, Перечисления.РешенияПроверки.Согласовано, Пример.Момент + 1);
			Пример.Согласованные.Добавить(Редакция); Пример.Передачи.Добавить(Передача); Пример.Решения.Добавить(Решение);
		КонецЦикла;
		Пример.Вставить("НоваяРедакция", НоваяРедакция(Пример.Документы[0], "3.0", Пример, "user-guide.md"));
		Пример.Вставить("НаПроверке", НоваяРедакция(Пример.Документы[1], "1.1", Пример, "installation.md"));
		Пример.Вставить("ОткрытаяПередача", Передать(Пример.НаПроверке, Пример, Пример.Момент));
		Пример.Вставить("НаДоработке", НоваяРедакция(Пример.Документы[1], "1.2", Пример, "installation.md"));
		Передача = Передать(Пример.НаДоработке, Пример, Пример.Момент);
		Решить(Передача, Перечисления.РешенияПроверки.НаДоработку, Пример.Момент + 1, "Уточнить шаги установки.");
		ЧужойДокумент = НовыйЭлемент(Справочники.ДокументыПродуктов, Префикс + "-FOREIGN", "Документ другого продукта", Новый Структура("Продукт,ВидДокументации", Пример.ДругойПродукт, Вид));
		Пример.Вставить("ЧужаяРедакция", НоваяРедакция(ЧужойДокумент, "1.0", Пример, "changelog.md"));
		План = НовыйПлан(Пример, Ложь); План.Документы[0].Редакция = Пример.Согласованные[0]; План.Документы[1].Редакция = Пример.НаПроверке;
		План.Записать(); Пример.Вставить("План", План.Ссылка);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Пример;
КонецФункции


// Общие функции подготовки примера добавляются сборщиком из проверок этапа 4.
Функция НовыйВыпуск(План)
	Выпуск = Документы.ВыпускКомплекта.СоздатьДокумент();
	Выпуск.Дата = ТекущаяДата(); Выпуск.ПланКомплекта = План;
	Возврат Выпуск;
КонецФункции

Процедура ПровестиВыпуск(Выпуск)
	Выпуск.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
КонецПроцедуры

Функция ОжидатьОтказВыпуска(Объект, Причина, Режим = Неопределено, Удаление = Ложь)
	Сообщение = "";
	Попытка
		Если Удаление Тогда
			Объект.Удалить();
		ИначеЕсли Режим = Неопределено Тогда
			ПровестиВыпуск(Объект);
		Иначе
			Объект.Записать(Режим);
		КонецЕсли;
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;
	Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
	Убедиться(СтрНайти(Сообщение, Причина) > 0, "Нет ожидаемого отказа: " + Причина + ". Получено: " + Сообщение);
	Возврат Сообщение;
КонецФункции

Функция КоличествоЗаписейВыпуска()
	Итог = "";
	Таблицы = "Документ.ПланКомплекта|Документ.ПередачаНаПроверку|Документ.РезультатПроверки|Документ.ВыпускКомплекта|РегистрСведений.СостоянияРедакций|Справочник.Продукты|Справочник.ВидыДокументации|Справочник.ДокументыПродуктов|Справочник.РедакцииДокументов|Справочник.Сотрудники";
	Для Каждого Таблица Из СтрРазделить(Таблицы, "|", Ложь) Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + Таблица);
		Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий();
		Итог = Итог + Строка(Выборка.Количество) + "|";
	КонецЦикла;
	Возврат Итог;
КонецФункции

Процедура ПроверитьСохранённыйСнимок(Выпуск, Пример, План)
	Прочитанный = Выпуск.Ссылка.ПолучитьОбъект();
	Убедиться(Прочитанный.Проведен, "Не сохранён признак проведения выпуска.");
	Убедиться(Прочитанный.ПланКомплекта = План.Ссылка И Прочитанный.Продукт = План.Продукт
		И Прочитанный.НомерРелиза = План.НомерРелиза И Прочитанный.Куратор = План.Куратор, "Не сохранена карточка выпуска.");
	Убедиться(Прочитанный.Документы.Количество() = 3, "Снимок не содержит три документа.");
	Для Индекс = 0 По 2 Цикл
		СтрокаВыпуска = Прочитанный.Документы[Индекс]; Редакция = Пример.Согласованные[Индекс];
		Убедиться(СтрокаВыпуска.ДокументПродукта = Пример.Документы[Индекс]
			И СтрокаВыпуска.Редакция = Редакция И СтрокаВыпуска.НомерРедакции = "1.0", "Не сохранена выбранная редакция.");
		Убедиться(СтрокаВыпуска.СсылкаНаТекст = Редакция.СсылкаНаТекст
			И СтрокаВыпуска.ИдентификаторСодержимого = Редакция.ИдентификаторСодержимого, "Не сохранён идентификатор проверенного текста.");
		Убедиться(СтрокаВыпуска.Передача = Пример.Передачи[Индекс]
			И СтрокаВыпуска.РешениеПроверки = Пример.Решения[Индекс]
			И СтрокаВыпуска.Проверяющий = Пример.Проверяющий
			И СтрокаВыпуска.ДатаСогласования = Пример.Решения[Индекс].Дата, "Не сохранено основание согласования.");
		Убедиться(СтрокаВыпуска.Ответственный = План.Документы[Индекс].Ответственный
			И СтрокаВыпуска.СрокПодготовки = План.Документы[Индекс].СрокПодготовки, "Потеряны ответственный или срок.");
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьСценарийВыпуска(Номер, Пример, Закреплённый)
	План = Пример.ГотовыйПлан.ПолучитьОбъект(); Выпуск = НовыйВыпуск(План.Ссылка);
	Если Номер = 1 Тогда
		Выпуск.Продукт = Пример.ДругойПродукт; Выпуск.Документы.Добавить(); Выпуск.Записать();
		Прочитанный = Выпуск.Ссылка.ПолучитьОбъект();
		Убедиться(Не Прочитанный.Проведен И Прочитанный.ПланКомплекта = План.Ссылка
			И Не ЗначениеЗаполнено(Прочитанный.Продукт) И Прочитанный.Документы.Количество() = 0, "Черновик содержит неподтверждённый снимок.");
	ИначеЕсли Номер = 2 Тогда
		ПровестиВыпуск(Выпуск); ПроверитьСохранённыйСнимок(Выпуск, Пример, План);
	ИначеЕсли Номер = 3 Тогда
		Выпуск = Закреплённый.Выпуск.ПолучитьОбъект(); До = КоличествоЗаписейВыпуска();
		ПровестиВыпуск(Выпуск); ПровестиВыпуск(Выпуск);
		Убедиться(КоличествоЗаписейВыпуска() = До, "Повторное проведение добавило записи.");
		Убедиться(КонтрольВыпуска.СовпадаетСнимок(Выпуск, Закреплённый.Выпуск.ПолучитьОбъект()), "Перепроведение изменило снимок.");
	ИначеЕсли Номер = 4 Тогда
		Выпуск.ПланКомплекта = Документы.ПланКомплекта.ПустаяСсылка();
		ОжидатьОтказВыпуска(Выпуск, "Выберите сохранённый план");
		НачатьТранзакцию();
		План = Пример.ГотовыйПлан.ПолучитьОбъект();
		План.ПометкаУдаления = Истина; План.Записать();
		ОжидатьОтказВыпуска(НовыйВыпуск(План.Ссылка), "План комплекта помечен на удаление");
	ИначеЕсли Номер = 5 Тогда
		Выпуск.ПланКомплекта = Пример.План;
		Сообщение = ОжидатьОтказВыпуска(Выпуск, "комплект не готов");
		Убедиться(СтрНайти(Сообщение, "Проверка выбранной редакции ещё не завершена") > 0
			И СтрНайти(Сообщение, "Не выбрана редакция документа") > 0, "Отказ не содержит все причины.");
	ИначеЕсли Номер = 6 Тогда
		Убедиться(ГотовностьКомплектов.РассчитатьГотовность(План.Ссылка).Готов, "Исходный план не готов.");
		План.Документы[1].Редакция = Пример.НаПроверке; План.Записать();
		ОжидатьОтказВыпуска(Выпуск, "Проверка выбранной редакции ещё не завершена");
	ИначеЕсли Номер = 7 Тогда
		Выпуск.Продукт = Пример.ДругойПродукт; Выпуск.НомерРелиза = "ПОДМЕНА";
		СтрокаВыпуска = Выпуск.Документы.Добавить(); СтрокаВыпуска.Редакция = Пример.ЧужаяРедакция;
		СтрокаВыпуска.ИдентификаторСодержимого = "ПОДМЕНА";
		ПровестиВыпуск(Выпуск); ПроверитьСохранённыйСнимок(Выпуск, Пример, План);
	ИначеЕсли Номер = 8 Тогда
		Выпуск.Дата = Пример.Момент;
		ОжидатьОтказВыпуска(Выпуск, "Дата выпуска не может быть раньше согласования");
	ИначеЕсли Номер = 9 Тогда
		Выпуск = Закреплённый.Выпуск.ПолучитьОбъект(); Выпуск.Дата = Выпуск.Дата + 1;
		ОжидатьОтказВыпуска(Выпуск, "не изменяйте реквизиты и зафиксированный состав");
	ИначеЕсли Номер = 10 Тогда
		Выпуск = Закреплённый.Выпуск.ПолучитьОбъект(); Выпуск.Документы[0].ИдентификаторСодержимого = "ПОДМЕНА";
		ОжидатьОтказВыпуска(Выпуск, "не изменяйте реквизиты и зафиксированный состав");
	ИначеЕсли Номер = 11 Тогда
		План = Закреплённый.ГотовыйПлан.ПолучитьОбъект(); План.НомерРелиза = "ИЗМЕНЁН";
		ОжидатьОтказВыпуска(План, "в проведённом выпуске", РежимЗаписиДокумента.Запись);
	ИначеЕсли Номер = 12 Тогда
		ОжидатьОтказВыпуска(Закреплённый.Решения[0].ПолучитьОбъект(), "в проведённом выпуске", РежимЗаписиДокумента.ОтменаПроведения);
	ИначеЕсли Номер = 13 Тогда
		ОжидатьОтказВыпуска(Закреплённый.Передачи[0].ПолучитьОбъект(), "в проведённом выпуске", РежимЗаписиДокумента.ОтменаПроведения);
	ИначеЕсли Номер = 14 Тогда
		Редакция = Закреплённый.Согласованные[0].ПолучитьОбъект(); Редакция.ПометкаУдаления = Истина;
		Попытка
			Редакция.Записать(); Сообщение = "";
		Исключение
			Сообщение = ОписаниеОшибки();
		КонецПопытки;
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		Убедиться(СтрНайти(Сообщение, "в проведённом выпуске") > 0, "Не защищена редакция выпущенного комплекта.");
	ИначеЕсли Номер = 15 Тогда
		Выпуск = Закреплённый.Выпуск.ПолучитьОбъект(); Снимок = Закреплённый.Выпуск.ПолучитьОбъект();
		Выпуск.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Убедиться(Не Выпуск.Ссылка.Проведен И КонтрольВыпуска.СовпадаетСнимок(Выпуск.Ссылка.ПолучитьОбъект(), Снимок), "Отмена уничтожила снимок или оставила проведение.");
		План = Закреплённый.ГотовыйПлан.ПолучитьОбъект(); План.НомерРелиза = "3.1"; План.Записать();
		Решение = Закреплённый.Решения[0].ПолучитьОбъект(); Решение.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Убедиться(Не Решение.Ссылка.Проведен, "Отмена выпуска не освободила основание согласования.");
	ИначеЕсли Номер = 16 Тогда
		ОжидатьОтказВыпуска(НовыйВыпуск(Закреплённый.ГотовыйПлан), "уже существует проведённый выпуск");
	ИначеЕсли Номер = 17 Тогда
		План = НовыйПлан(Закреплённый); План.НомерРелиза = "3.0"; План.Записать();
		ОжидатьОтказВыпуска(НовыйВыпуск(План.Ссылка), "уже существует проведённый выпуск");
	ИначеЕсли Номер = 18 Тогда
		Новая = НоваяРедакция(Закреплённый.Документы[0], "9.0", Закреплённый, "user-guide.md");
		Убедиться(ЗначениеЗаполнено(Новая), "Не создана новая редакция.");
		ПрочитанныйВыпуск = Закреплённый.Выпуск.ПолучитьОбъект();
		Убедиться(ПрочитанныйВыпуск.Документы[0].Редакция = Закреплённый.Согласованные[0]
			И ПрочитанныйВыпуск.Документы[0].НомерРедакции = "1.0", "Новая редакция изменила выпущенный состав.");
	ИначеЕсли Номер = 19 Тогда
		ОжидатьОтказВыпуска(Закреплённый.Выпуск.ПолучитьОбъект(), "Сначала отмените проведение выпуска", РежимЗаписиДокумента.Запись);
	ИначеЕсли Номер = 20 Тогда
		Выпуск = Закреплённый.Выпуск.ПолучитьОбъект(); Выпуск.Документы.Очистить();
		ОжидатьОтказВыпуска(Выпуск, "не изменяйте реквизиты и зафиксированный состав", РежимЗаписиДокумента.ОтменаПроведения);
	ИначеЕсли Номер = 21 Тогда
		ОжидатьОтказВыпуска(Закреплённый.ГотовыйПлан.ПолучитьОбъект(), "в проведённом выпуске", Неопределено, Истина);
	ИначеЕсли Номер = 22 Тогда
		ОжидатьОтказВыпуска(Закреплённый.Выпуск.ПолучитьОбъект(), "Перед удалением сначала отмените проведение выпуска", Неопределено, Истина);
	ИначеЕсли Номер = 23 Тогда
		ОжидатьОтказВыпуска(Закреплённый.Решения[0].ПолучитьОбъект(), "в проведённом выпуске", Неопределено, Истина);
		НачатьТранзакцию();
		Убедиться(ГотовностьКомплектов.РассчитатьГотовность(План.Ссылка).Готов, "Исходное согласование не действительно.");
		Решение = Пример.Решения[0].ПолучитьОбъект(); Решение.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ОжидатьОтказВыпуска(НовыйВыпуск(План.Ссылка), "Проверка выбранной редакции ещё не завершена");
	КонецЕсли;
КонецПроцедуры

Процедура ЗапуститьПроверкиВыпуска(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска) Экспорт
	ПраваДокументации.ТребоватьАдминистратора();
	ПроверкиГотовности.ЗапуститьПроверкиГотовности(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска);
	Информация = Новый СистемнаяИнформация;
	Результат = Новый Структура("phase,version,run_id,source_digest,platform_version,status,tests,passed_count,failed_count,error",
		"milestone_5_release_runtime", "0.7.0-dev", ИдентификаторЗапуска, ХешИсходников, Информация.ВерсияПриложения, "FAIL", Новый Массив, 0, 0, "");
	Результат.Вставить("manual_UI", "PENDING");
	Попытка
		Пример = СоздатьПример(ПапкаЗапуска, "RL"); Закреплённый = СоздатьПример(ПапкаЗапуска, "RX");
		План = НовыйПлан(Пример); План.Записать(); Пример.Вставить("ГотовыйПлан", План.Ссылка);
		План = НовыйПлан(Закреплённый); План.Записать(); Закреплённый.Вставить("ГотовыйПлан", План.Ссылка);
		Выпуск = НовыйВыпуск(План.Ссылка); ПровестиВыпуск(Выпуск); Закреплённый.Вставить("Выпуск", Выпуск.Ссылка);
		Для Номер = 1 По 23 Цикл
			Проверка = Новый Структура("id,status,error", "RL-" + Прав("0" + Строка(Номер), 2), "FAIL", "");
			До = КоличествоЗаписейВыпуска(); Снимок = Закреплённый.Выпуск.ПолучитьОбъект();
			Попытка
				НачатьТранзакцию(); ПроверитьСценарийВыпуска(Номер, Пример, Закреплённый);
				Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
				Убедиться(КоличествоЗаписейВыпуска() = До, "После испытания остались частичные записи.");
				Прочитанный = Закреплённый.Выпуск.ПолучитьОбъект();
				Убедиться(Прочитанный.Проведен И Прочитанный.Дата = Снимок.Дата
					И КонтрольВыпуска.СовпадаетСнимок(Прочитанный, Снимок), "Испытание изменило прежний проведённый выпуск.");
				Проверка.status = "PASS"; Результат.passed_count = Результат.passed_count + 1;
			Исключение
				Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
				Проверка.error = ОписаниеОшибки(); Результат.failed_count = Результат.failed_count + 1;
			КонецПопытки;
			Результат.tests.Добавить(Проверка);
		КонецЦикла;
		Черновик = НовыйВыпуск(Пример.ГотовыйПлан); Черновик.Записать();
		Результат.Вставить("demo_release", Строка(Черновик.Ссылка));
		Результат.Вставить("demo_plan", Строка(Пример.ГотовыйПлан));
		Результат.Вставить("posted_example", Строка(Закреплённый.Выпуск));
		Если Результат.failed_count = 0 Тогда Результат.status = "PASS"; КонецЕсли;
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		Результат.error = ОписаниеОшибки(); Результат.failed_count = Результат.failed_count + 1;
	КонецПопытки;
	Запись = Новый ЗаписьJSON; Запись.ОткрытьФайл(ПапкаЗапуска + "\release-tests.json"); ЗаписатьJSON(Запись, Результат); Запись.Закрыть();
КонецПроцедуры
