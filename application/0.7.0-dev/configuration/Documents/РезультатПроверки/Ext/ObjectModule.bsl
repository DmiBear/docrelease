Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	ПраваДокументации.ПроверитьЗапись(ЭтотОбъект);
	КонтрольВыпуска.ПроверитьЗависимость(Ссылка);
	КонтрольДокументации.ПроверитьЗаписьПроведённого(ЭтотОбъект, РежимЗаписи, "Дата,Передача,Проверяющий,Решение,Замечание");
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Если Не ЗначениеЗаполнено(Передача) Или Не ЗначениеЗаполнено(Проверяющий) Или Не ЗначениеЗаполнено(Решение) Тогда
			ВызватьИсключение "Укажите передачу, проверяющего и решение.";
		КонецЕсли;
		Замечание = СокрЛП(Замечание);
		Если Решение = Перечисления.РешенияПроверки.НаДоработку И Не ЗначениеЗаполнено(Замечание) Тогда
			ВызватьИсключение "При возврате на доработку укажите замечание.";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	КонтрольДокументации.ПровестиРешение(ЭтотОбъект);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	КонтрольДокументации.ПроверитьПоследнююОперацию(ЭтотОбъект, Передача.Редакция);
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	ПраваДокументации.ПроверитьУдаление(ЭтотОбъект);
	КонтрольВыпуска.ПроверитьЗависимость(Ссылка);
КонецПроцедуры
