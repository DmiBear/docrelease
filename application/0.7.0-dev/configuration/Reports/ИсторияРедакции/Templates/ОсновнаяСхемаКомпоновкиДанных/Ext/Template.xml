		<dataSource>База</dataSource>
		<query>ВЫБРАТЬ
    История.Редакция КАК Редакция,
    История.Период КАК ДатаСобытия,
    История.Состояние КАК Состояние,
    История.Регистратор КАК Событие,
    История.Проверяющий КАК Проверяющий,
    История.Передача КАК Передача,
    ЕСТЬNULL(ВЫРАЗИТЬ(История.Регистратор КАК Документ.РезультатПроверки).Замечание, "") КАК Замечание,
    Передачи.СсылкаНаТекст КАК СсылкаНаТекст,
    Передачи.ИдентификаторСодержимого КАК ИдентификаторСодержимого
ИЗ
    РегистрСведений.СостоянияРедакций КАК История
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПередачаНаПроверку КАК Передачи
        ПО История.Передача = Передачи.Ссылка
ГДЕ
    История.Активность И История.Редакция = &amp;Редакция
    И Передачи.Проведен И НЕ Передачи.ПометкаУдаления
    И (История.Регистратор ССЫЛКА Документ.ПередачаНаПроверку
        ИЛИ (ВЫРАЗИТЬ(История.Регистратор КАК Документ.РезультатПроверки).Проведен
            И НЕ ВЫРАЗИТЬ(История.Регистратор КАК Документ.РезультатПроверки).ПометкаУдаления))
УПОРЯДОЧИТЬ ПО
    ДатаСобытия, Событие
</query>
