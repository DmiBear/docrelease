Процедура Убедиться(Условие, Текст)
	Если Не Условие Тогда
		ВызватьИсключение Текст;
	КонецЕсли;
КонецПроцедуры

Функция НовыйЭлемент(Менеджер, Код, Название, Поля)
	Убедиться(Менеджер.НайтиПоКоду(Код).Пустая(), "Занят код проверочного примера: " + Код);
	Объект = Менеджер.СоздатьЭлемент(); Объект.Код = Код; Объект.Наименование = Название;
	Для Каждого Поле Из Поля Цикл
		Объект[Поле.Ключ] = Поле.Значение;
	КонецЦикла;
	Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Функция НоваяРедакция(ДокументПродукта, Версия, Пример, ИмяФайла)
	Редакция = Справочники.РедакцииДокументов.СоздатьЭлемент();
	Редакция.ДокументПродукта = ДокументПродукта; Редакция.НомерРедакции = Версия; Редакция.Автор = Пример.Автор;
	Путь = Пример.ПапкаЗапуска + "\examples\" + ИмяФайла;
	Редакция.СсылкаНаТекст = "file:///" + СтрЗаменить(Путь, "\", "/");
	ТекстХеша = Новый ТекстовыйДокумент; ТекстХеша.Прочитать(Путь + ".sha256");
	Редакция.ИдентификаторСодержимого = СокрЛП(ТекстХеша.ПолучитьТекст());
	Убедиться(СтрДлина(Редакция.ИдентификаторСодержимого) = 64, "Не найден хеш проверочного текста.");
	Редакция.Записать(); Возврат Редакция.Ссылка;
КонецФункции

Функция Передать(Редакция, Пример, Момент)
	Передача = Документы.ПередачаНаПроверку.СоздатьДокумент();
	Передача.Дата = Момент; Передача.Редакция = Редакция; Передача.Проверяющий = Пример.Проверяющий;
	Передача.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Возврат Передача.Ссылка;
КонецФункции

Функция Решить(Передача, РешениеПроверки, Момент, Замечание = "")
	Решение = Документы.РезультатПроверки.СоздатьДокумент(); Решение.Дата = Момент;
	Решение.Передача = Передача; Решение.Проверяющий = Передача.Проверяющий;
	Решение.Решение = РешениеПроверки; Решение.Замечание = Замечание;
	Решение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Возврат Решение.Ссылка;
КонецФункции

Функция НовыйПлан(Пример, ВсеСогласованы = Истина)
	План = Документы.ПланКомплекта.СоздатьДокумент(); План.Дата = ТекущаяДата();
	План.Продукт = Пример.Продукт; План.Куратор = Пример.Автор; План.НомерРелиза = "2.0";
	Для Индекс = 0 По 2 Цикл
		СтрокаПлана = План.Документы.Добавить(); СтрокаПлана.ДокументПродукта = Пример.Документы[Индекс];
		СтрокаПлана.Ответственный = Пример.Автор; СтрокаПлана.СрокПодготовки = НачалоДня(ТекущаяДата()) + 7 * 86400;
		Если ВсеСогласованы Тогда
			СтрокаПлана.Редакция = Пример.Согласованные[Индекс];
		КонецЕсли;
	КонецЦикла;
	Возврат План;
КонецФункции

Функция СоздатьПример(ПапкаЗапуска)
	НачатьТранзакцию();
	Попытка
		Пример = Новый Структура("ПапкаЗапуска,Документы,Согласованные,Передачи,Решения", ПапкаЗапуска, Новый Массив, Новый Массив, Новый Массив, Новый Массив);
		Пример.Вставить("Продукт", НовыйЭлемент(Справочники.Продукты, "GR-PRODUCT", "DocRelease — пример готовности", Новый Структура));
		Пример.Вставить("ДругойПродукт", НовыйЭлемент(Справочники.Продукты, "GR-OTHER", "Другой проверочный продукт", Новый Структура));
		Пример.Вставить("Автор", НовыйЭлемент(Справочники.Сотрудники, "GR-AUTHOR", "Автор комплекта", Новый Структура));
		Пример.Вставить("Проверяющий", НовыйЭлемент(Справочники.Сотрудники, "GR-REVIEWER", "Проверяющий комплекта", Новый Структура));
		Названия = СтрРазделить("Руководство пользователя|Инструкция установки|Описание изменений", "|", Ложь);
		Файлы = СтрРазделить("user-guide.md|installation.md|changelog.md", "|", Ложь);
		Пример.Вставить("Момент", ТекущаяДата() - 300);
		Для Индекс = 0 По 2 Цикл
			Вид = НовыйЭлемент(Справочники.ВидыДокументации, "GR-TYPE-" + Строка(Индекс + 1), Названия[Индекс], Новый Структура);
			ДокументПродукта = НовыйЭлемент(Справочники.ДокументыПродуктов, "GR-DOC-" + Строка(Индекс + 1), Названия[Индекс] + " — пример готовности",
				Новый Структура("Продукт,ВидДокументации", Пример.Продукт, Вид));
			Пример.Документы.Добавить(ДокументПродукта);
			Редакция = НоваяРедакция(ДокументПродукта, "1.0", Пример, Файлы[Индекс]);
			Передача = Передать(Редакция, Пример, Пример.Момент);
			Решение = Решить(Передача, Перечисления.РешенияПроверки.Согласовано, Пример.Момент + 1);
			Пример.Согласованные.Добавить(Редакция); Пример.Передачи.Добавить(Передача); Пример.Решения.Добавить(Решение);
		КонецЦикла;
		Пример.Вставить("НоваяРедакция", НоваяРедакция(Пример.Документы[0], "2.0", Пример, "user-guide.md"));
		Пример.Вставить("НаПроверке", НоваяРедакция(Пример.Документы[1], "1.1", Пример, "installation.md"));
		Пример.Вставить("ОткрытаяПередача", Передать(Пример.НаПроверке, Пример, Пример.Момент));
		Пример.Вставить("НаДоработке", НоваяРедакция(Пример.Документы[1], "1.2", Пример, "installation.md"));
		Передача = Передать(Пример.НаДоработке, Пример, Пример.Момент);
		Решить(Передача, Перечисления.РешенияПроверки.НаДоработку, Пример.Момент + 1, "Уточнить шаги установки.");
		ЧужойДокумент = НовыйЭлемент(Справочники.ДокументыПродуктов, "GR-FOREIGN", "Документ другого продукта", Новый Структура("Продукт,ВидДокументации", Пример.ДругойПродукт, Вид));
		Пример.Вставить("ЧужаяРедакция", НоваяРедакция(ЧужойДокумент, "1.0", Пример, "changelog.md"));
		План = НовыйПлан(Пример, Ложь); План.Документы[0].Редакция = Пример.Согласованные[0]; План.Документы[1].Редакция = Пример.НаПроверке;
		План.Записать(); Пример.Вставить("План", План.Ссылка);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Пример;
КонецФункции

Функция ЕстьПричина(Оценка, Код)
	Для Каждого Причина Из Оценка.Причины Цикл
		Если Причина.Код = Код Тогда Возврат Истина; КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ОжидатьОтказ(Объект, Причина, Режим = Неопределено)
	Сообщение = ""; НачатьТранзакцию();
	Попытка
		Если Режим = Неопределено Тогда Объект.Записать(); Иначе Объект.Записать(Режим); КонецЕсли;
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;
	Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
	Убедиться(СтрНайти(Сообщение, Причина) > 0, "Нет ожидаемого отказа: " + Причина + ". Получено: " + Сообщение);
КонецПроцедуры

Функция КоличествоЗаписей()
	Результат = "";
	Для Каждого Таблица Из СтрРазделить("Документ.ПланКомплекта|Документ.ПередачаНаПроверку|Документ.РезультатПроверки|РегистрСведений.СостоянияРедакций", "|", Ложь) Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + Таблица);
		Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий(); Результат = Результат + Строка(Выборка.Количество) + "|";
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПроверитьСценарий(Номер, Пример)
	План = НовыйПлан(Пример);
	Если Номер = 1 Тогда
		НачатьТранзакцию(); План.Записать(); Прочитанный = План.Ссылка.ПолучитьОбъект();
		Для Индекс = 0 По 2 Цикл Убедиться(Прочитанный.Документы[Индекс].Редакция = Пример.Согласованные[Индекс], "Не сохранена выбранная редакция."); КонецЦикла;
		ОтменитьТранзакцию();
	ИначеЕсли Номер = 2 Тогда
		План.Документы[0].Редакция = Пример.Согласованные[1]; ОжидатьОтказ(План, "редакция относится к другому документу");
	ИначеЕсли Номер = 3 Тогда
		План.Документы[0].Редакция = Пример.ЧужаяРедакция; ОжидатьОтказ(План, "редакция относится к другому документу");
		Оценка = ГотовностьКомплектов.РассчитатьПоДаннымПлана(План);
		Убедиться(ЕстьПричина(Оценка, "WRONG_REVISION_DOCUMENT") И ЕстьПричина(Оценка, "WRONG_REVISION_PRODUCT"), "Не выявлены обе ошибки принадлежности редакции.");
	ИначеЕсли Номер = 4 Тогда
		План.Документы[1].Редакция = Пример.НаДоработке; План.Документы[2].Редакция = Справочники.РедакцииДокументов.ПустаяСсылка();
		Оценка = ГотовностьКомплектов.РассчитатьПоДаннымПлана(План);
		Убедиться(Не Оценка.Готов И Оценка.Причины.Количество() = 2 И Оценка.ГотовоДокументов = 1, "Смешанный комплект должен иметь ровно две причины неготовности.");
		Убедиться(ЕстьПричина(Оценка, "REVIEW_REJECTED") И ЕстьПричина(Оценка, "REVISION_REQUIRED"), "Потеряна одна из причин неготовности.");
	ИначеЕсли Номер = 5 Тогда
		Оценка = ГотовностьКомплектов.РассчитатьПоДаннымПлана(План);
		Убедиться(Оценка.Готов И Оценка.Причины.Количество() = 0 И Оценка.ГотовоДокументов = 3, "Полностью согласованный комплект не признан готовым.");
	ИначеЕсли Номер = 6 Тогда
		План.Документы[0].Редакция = Пример.НоваяРедакция; Оценка = ГотовностьКомплектов.РассчитатьПоДаннымПлана(План);
		Убедиться(Не Оценка.Готов И ЕстьПричина(Оценка, "REVIEW_NOT_STARTED"), "Новая редакция унаследовала согласование прежней.");
	ИначеЕсли Номер = 7 Тогда
		Оценка = ГотовностьКомплектов.РассчитатьГотовность(Пример.План);
		Убедиться(Не Оценка.Готов И Оценка.Причины.Количество() = 2 И ЕстьПричина(Оценка, "REVIEW_PENDING") И ЕстьПричина(Оценка, "REVISION_REQUIRED"), "Не показаны причины по демонстрационному плану.");
	ИначеЕсли Номер = 8 Тогда
		НачатьТранзакцию(); Решение = Пример.Решения[0].ПолучитьОбъект(); Решение.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Оценка = ГотовностьКомплектов.РассчитатьПоДаннымПлана(План);
		Убедиться(Не Оценка.Готов И ЕстьПричина(Оценка, "REVIEW_PENDING"), "Отменённое согласование продолжает давать готовность."); ОтменитьТранзакцию();
	ИначеЕсли Номер = 9 Тогда
		НачатьТранзакцию(); Решить(Пример.ОткрытаяПередача, Перечисления.РешенияПроверки.НаДоработку, Пример.Момент + 1, "Уточнить шаги.");
		НоваяПередача = Передать(Пример.НаПроверке, Пример, Пример.Момент + 2);
		Решить(НоваяПередача, Перечисления.РешенияПроверки.Согласовано, Пример.Момент + 3);
		План.Документы[1].Редакция = Пример.НаПроверке;
		Убедиться(ГотовностьКомплектов.РассчитатьПоДаннымПлана(План).Готов, "Повторная проверка и согласование не восстановили готовность."); ОтменитьТранзакцию();
	ИначеЕсли Номер = 10 Тогда
		Редакция = Пример.Согласованные[0].ПолучитьОбъект(); Передача = Пример.Передачи[0].ПолучитьОбъект();
		Убедиться(ГотовностьКомплектов.СовпадаетПроверенныйТекст(Редакция, Передача), "Совпадающий текст не подтверждён.");
		Редакция.СсылкаНаТекст = "https://example.invalid/changed";
		Убедиться(Не ГотовностьКомплектов.СовпадаетПроверенныйТекст(Редакция, Передача), "Не замечена подмена ссылки в данных.");
		Редакция.СсылкаНаТекст = Передача.СсылкаНаТекст; Редакция.ИдентификаторСодержимого = "OTHER";
		Убедиться(Не ГотовностьКомплектов.СовпадаетПроверенныйТекст(Редакция, Передача), "Не замечена подмена идентификатора.");
		Редакция.ИдентификаторСодержимого = Передача.ИдентификаторСодержимого; Редакция.СсылкаНаТекст = "";
		Убедиться(Не ГотовностьКомплектов.СовпадаетПроверенныйТекст(Редакция, Передача), "Пустая ссылка признана подтверждённой.");
	ИначеЕсли Номер = 11 Тогда
		Для Каждого СтрокаПлана Из План.Документы Цикл СтрокаПлана.СрокПодготовки = НачалоДня(ТекущаяДата()) - 86400; КонецЦикла;
		Оценка = ГотовностьКомплектов.РассчитатьПоДаннымПлана(План);
		Убедиться(Оценка.Готов И Оценка.Причины.Количество() = 0 И Оценка.Предупреждения.Количество() = 3, "Прошедший срок изменил правило готовности.");
	ИначеЕсли Номер = 12 Тогда
		План.Документы[0].Редакция = Пример.НоваяРедакция; План.Документы[1].Редакция = Пример.НаДоработке; План.Документы[2].Редакция = Справочники.РедакцииДокументов.ПустаяСсылка();
		Оценка = ГотовностьКомплектов.РассчитатьПоДаннымПлана(План);
		Убедиться(Оценка.Причины.Количество() = 3 И Оценка.Строки.Количество() = 3, "Алгоритм остановился на первой ошибке.");
	ИначеЕсли Номер = 13 Тогда
		План.Продукт = Справочники.Продукты.ПустаяСсылка(); План.Куратор = Справочники.Сотрудники.ПустаяСсылка(); План.НомерРелиза = "   "; План.Документы.Очистить();
		Оценка = ГотовностьКомплектов.РассчитатьПоДаннымПлана(План);
		Убедиться(Не Оценка.Готов И Оценка.Причины.Количество() = 4 И Оценка.ГотовоДокументов = 0, "Пустой план признан готовым или потеряны ошибки карточки.");
	ИначеЕсли Номер = 14 Тогда
		ДокументПродукта = Пример.Документы[0].ПолучитьОбъект(); ДокументПродукта.Продукт = Пример.ДругойПродукт;
		ОжидатьОтказ(ДокументПродукта, "Документ уже используется");
		Убедиться(Пример.Документы[0].Продукт = Пример.Продукт, "После отказа изменился продукт документа.");
	ИначеЕсли Номер = 15 Тогда
		Решение = Пример.Решения[0].ПолучитьОбъект(); Решение.Дата = Пример.Момент + 100;
		ОжидатьОтказ(Решение, "не изменяйте реквизиты", РежимЗаписиДокумента.ОтменаПроведения);
		Убедиться(Пример.Решения[0].Проведен, "Запрещённая отмена сняла проведение решения.");
		Передача = Пример.Передачи[0].ПолучитьОбъект(); Передача.Дата = Пример.Момент + 100;
		ОжидатьОтказ(Передача, "не изменяйте реквизиты", РежимЗаписиДокумента.ОтменаПроведения);
		Убедиться(Пример.Передачи[0].Проведен, "Запрещённая отмена сняла проведение передачи.");
	ИначеЕсли Номер = 16 Тогда
		Редакция = Пример.Согласованные[0].ПолучитьОбъект(); Редакция.ИдентификаторСодержимого = "CHANGED";
		ОжидатьОтказ(Редакция, "уже передана на проверку");
		Убедиться(ГотовностьКомплектов.РассчитатьПоДаннымПлана(План).Готов, "Отказ изменения испортил согласованную редакцию.");
	ИначеЕсли Номер = 17 Тогда
		До = КоличествоЗаписей(); Оценка = ГотовностьКомплектов.РассчитатьГотовность(Пример.План);
		Отчёт = ГотовностьКомплектов.СформироватьОтчёт(Пример.План);
		Убедиться(Отчёт.Область(4, 1).Текст = "КОМПЛЕКТ НЕ ГОТОВ", "Итог отчёта не совпал с расчётом.");
		Убедиться(СтрНайти(Отчёт.Область(5, 1).Текст, "Причин неготовности: 2") > 0, "Отчёт потерял число причин.");
		Убедиться(КоличествоЗаписей() = До, "Расчёт или отчёт изменил записи базы.");
		// В учебной версии проверяем содержимое в памяти; просмотр подтверждается отдельно в интерфейсе.
	ИначеЕсли Номер = 18 Тогда
		Оценка = ГотовностьКомплектов.РассчитатьГотовность(Документы.ПланКомплекта.ПустаяСсылка());
		Убедиться(Не Оценка.Готов И ЕстьПричина(Оценка, "PLAN_REQUIRED"), "Отсутствующий план признан готовым.");
	КонецЕсли;
КонецПроцедуры

Процедура ЗапуститьПроверкиГотовности(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска) Экспорт
	ПраваДокументации.ТребоватьАдминистратора();
	ПроверкиКомплектов.ЗапуститьПроверкиПлана(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска);
	Информация = Новый СистемнаяИнформация;
	Результат = Новый Структура("phase,version,run_id,source_digest,platform_version,status,tests,passed_count,failed_count,error",
		"milestone_4_readiness_runtime", "0.7.0-dev", ИдентификаторЗапуска, ХешИсходников, Информация.ВерсияПриложения, "FAIL", Новый Массив, 0, 0, "");
	Результат.Вставить("manual_UI", "PENDING");
	Попытка
		Пример = СоздатьПример(ПапкаЗапуска);
		Результат.Вставить("demo_plan", Строка(Пример.План));
		Для Номер = 1 По 18 Цикл
			Проверка = Новый Структура("id,status,error", "GR-" + Прав("0" + Строка(Номер), 2), "FAIL", "");
			Попытка
				ПроверитьСценарий(Номер, Пример); Проверка.status = "PASS"; Результат.passed_count = Результат.passed_count + 1;
			Исключение
				Проверка.error = ОписаниеОшибки(); Результат.failed_count = Результат.failed_count + 1;
			КонецПопытки;
			Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
			Результат.tests.Добавить(Проверка);
		КонецЦикла;
		Если Результат.failed_count = 0 Тогда Результат.status = "PASS"; КонецЕсли;
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		Результат.error = ОписаниеОшибки(); Результат.failed_count = Результат.failed_count + 1;
	КонецПопытки;
	Запись = Новый ЗаписьJSON; Запись.ОткрытьФайл(ПапкаЗапуска + "\readiness-tests.json"); ЗаписатьJSON(Запись, Результат); Запись.Закрыть();
КонецПроцедуры
