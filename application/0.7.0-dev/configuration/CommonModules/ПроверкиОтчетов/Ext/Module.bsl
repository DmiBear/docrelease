Процедура Убедиться(Условие, Текст)
	Если Не Условие Тогда
		ВызватьИсключение Текст;
	КонецЕсли;
КонецПроцедуры

Функция НовыйЭлемент(Менеджер, Код, Название, Поля)
	Убедиться(Менеджер.НайтиПоКоду(Код).Пустая(), "Занят код проверочного примера: " + Код);
	Объект = Менеджер.СоздатьЭлемент(); Объект.Код = Код; Объект.Наименование = Название;
	Для Каждого Поле Из Поля Цикл
		Объект[Поле.Ключ] = Поле.Значение;
	КонецЦикла;
	Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Функция НоваяРедакция(ДокументПродукта, Версия, Пример, ИмяФайла)
	Редакция = Справочники.РедакцииДокументов.СоздатьЭлемент();
	Редакция.ДокументПродукта = ДокументПродукта; Редакция.НомерРедакции = Версия; Редакция.Автор = Пример.Автор;
	Путь = Пример.ПапкаЗапуска + "\examples\" + ИмяФайла;
	Редакция.СсылкаНаТекст = "file:///" + СтрЗаменить(Путь, "\", "/");
	ТекстХеша = Новый ТекстовыйДокумент; ТекстХеша.Прочитать(Путь + ".sha256");
	Редакция.ИдентификаторСодержимого = СокрЛП(ТекстХеша.ПолучитьТекст());
	Убедиться(СтрДлина(Редакция.ИдентификаторСодержимого) = 64, "Не найден хеш проверочного текста.");
	Редакция.Записать(); Возврат Редакция.Ссылка;
КонецФункции

Функция Передать(Редакция, Пример, Момент)
	Передача = Документы.ПередачаНаПроверку.СоздатьДокумент();
	Передача.Дата = Момент; Передача.Редакция = Редакция; Передача.Проверяющий = Пример.Проверяющий;
	Передача.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Возврат Передача.Ссылка;
КонецФункции

Функция Решить(Передача, РешениеПроверки, Момент, Замечание = "")
	Решение = Документы.РезультатПроверки.СоздатьДокумент(); Решение.Дата = Момент;
	Решение.Передача = Передача; Решение.Проверяющий = Передача.Проверяющий;
	Решение.Решение = РешениеПроверки; Решение.Замечание = Замечание;
	Решение.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Возврат Решение.Ссылка;
КонецФункции

Функция НовыйПлан(Пример, ВсеСогласованы = Истина)
	План = Документы.ПланКомплекта.СоздатьДокумент(); План.Дата = ТекущаяДата();
	План.Продукт = Пример.Продукт; План.Куратор = Пример.Автор; План.НомерРелиза = "2.0";
	Для Индекс = 0 По 2 Цикл
		СтрокаПлана = План.Документы.Добавить(); СтрокаПлана.ДокументПродукта = Пример.Документы[Индекс];
		СтрокаПлана.Ответственный = Пример.Автор; СтрокаПлана.СрокПодготовки = НачалоДня(ТекущаяДата()) + 7 * 86400;
		Если ВсеСогласованы Тогда
			СтрокаПлана.Редакция = Пример.Согласованные[Индекс];
		КонецЕсли;
	КонецЦикла;
	Возврат План;
КонецФункции

Функция СоздатьПример(ПапкаЗапуска)
	НачатьТранзакцию();
	Попытка
		Пример = Новый Структура("ПапкаЗапуска,Документы,Согласованные,Передачи,Решения", ПапкаЗапуска, Новый Массив, Новый Массив, Новый Массив, Новый Массив);
		Пример.Вставить("Продукт", НовыйЭлемент(Справочники.Продукты, "RP-PRODUCT", "DocRelease — пример отчётов", Новый Структура));
		Пример.Вставить("ДругойПродукт", НовыйЭлемент(Справочники.Продукты, "RP-OTHER", "Другой проверочный продукт", Новый Структура));
		Пример.Вставить("Автор", НовыйЭлемент(Справочники.Сотрудники, "RP-AUTHOR", "Автор комплекта", Новый Структура));
		Пример.Вставить("Проверяющий", НовыйЭлемент(Справочники.Сотрудники, "RP-REVIEWER", "Проверяющий комплекта", Новый Структура));
		Названия = СтрРазделить("Руководство пользователя|Инструкция установки|Описание изменений", "|", Ложь);
		Файлы = СтрРазделить("user-guide.md|installation.md|changelog.md", "|", Ложь);
		Пример.Вставить("Момент", ТекущаяДата() - 300);
		Для Индекс = 0 По 2 Цикл
			Вид = НовыйЭлемент(Справочники.ВидыДокументации, "RP-TYPE-" + Строка(Индекс + 1), Названия[Индекс], Новый Структура);
			ДокументПродукта = НовыйЭлемент(Справочники.ДокументыПродуктов, "RP-DOC-" + Строка(Индекс + 1), Названия[Индекс] + " — пример отчётов",
				Новый Структура("Продукт,ВидДокументации", Пример.Продукт, Вид));
			Пример.Документы.Добавить(ДокументПродукта);
			Редакция = НоваяРедакция(ДокументПродукта, "1.0", Пример, Файлы[Индекс]);
			Передача = Передать(Редакция, Пример, Пример.Момент);
			Решение = Решить(Передача, Перечисления.РешенияПроверки.Согласовано, Пример.Момент + 1);
			Пример.Согласованные.Добавить(Редакция); Пример.Передачи.Добавить(Передача); Пример.Решения.Добавить(Решение);
		КонецЦикла;
		Пример.Вставить("НоваяРедакция", НоваяРедакция(Пример.Документы[0], "2.0", Пример, "user-guide.md"));
		Пример.Вставить("НаПроверке", НоваяРедакция(Пример.Документы[1], "1.1", Пример, "installation.md"));
		Пример.Вставить("ОткрытаяПередача", Передать(Пример.НаПроверке, Пример, Пример.Момент));
		Пример.Вставить("НаДоработке", НоваяРедакция(Пример.Документы[1], "1.2", Пример, "installation.md"));
		Передача = Передать(Пример.НаДоработке, Пример, Пример.Момент);
		Решить(Передача, Перечисления.РешенияПроверки.НаДоработку, Пример.Момент + 1, "Уточнить шаги установки.");
		ЧужойДокумент = НовыйЭлемент(Справочники.ДокументыПродуктов, "RP-FOREIGN", "Документ другого продукта", Новый Структура("Продукт,ВидДокументации", Пример.ДругойПродукт, Вид));
		Пример.Вставить("ЧужаяРедакция", НоваяРедакция(ЧужойДокумент, "1.0", Пример, "changelog.md"));
		План = НовыйПлан(Пример, Ложь); План.Документы[0].Редакция = Пример.Согласованные[0]; План.Документы[1].Редакция = Пример.НаПроверке;
		План.Записать(); Пример.Вставить("План", План.Ссылка);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Пример;
КонецФункции


// Подготовка справочных данных добавляется из проверенной группы GR с префиксом RP.
Функция Очередь(Пример, Проверяющий = Неопределено)
	Возврат СервисОтчетов.ПолучитьДанные("ДокументыНаПроверке", Новый Структура("Продукт,Проверяющий", Пример.Продукт, Проверяющий));
КонецФункции

Функция История(Редакция)
	Возврат СервисОтчетов.ПолучитьДанные("ИсторияРедакции", Новый Структура("Редакция", Редакция));
КонецФункции

Функция ТекстТаблицы(Документ)
	Текст = "";
	Для СтрокаТаблицы = 1 По Документ.ВысотаТаблицы Цикл
		Для Колонка = 1 По Документ.ШиринаТаблицы Цикл
			Текст = Текст + Документ.Область(СтрокаТаблицы, Колонка).Текст + Символы.ПС;
		КонецЦикла;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция Сформировать(ИмяОтчета, Параметры)
	Если ИмяОтчета = "ДокументыНаПроверке" Тогда
		ОбъектОтчета = Отчеты.ДокументыНаПроверке.Создать();
	Иначе
		ОбъектОтчета = Отчеты.ИсторияРедакции.Создать();
	КонецЕсли;
	Возврат ОбъектОтчета.СформироватьДляПараметров(Параметры);
КонецФункции

Функция ЕстьЯчейка(Документ, Значение)
	Для НомерСтроки = 1 По Документ.ВысотаТаблицы Цикл
		Для НомерКолонки = 1 По Документ.ШиринаТаблицы Цикл
			Если СокрЛП(Документ.Область(НомерСтроки, НомерКолонки).Текст) = Значение Тогда Возврат Истина; КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ДобавитьДиагностикуВывода(Диагностика, ИмяОтчета, Параметры, Документ, Контекст)
	Схема = СервисОтчетов.СхемаОтчета(ИмяОтчета);
	ОсновныеНастройки = СервисОтчетов.НастройкиПоПараметрам(ИмяОтчета, Параметры);
	БазовыеНастройки = Схема.НастройкиПоУмолчанию;
	Данные = СервисОтчетов.ПолучитьДанные(ИмяОтчета, Параметры);
	Диагностика.Добавить(Новый Структура("context,report,source_rows,height,width,selected_fields,structure_items,default_selected_fields,default_structure_items,text",
		Контекст, ИмяОтчета, Данные.Количество(), Документ.ВысотаТаблицы, Документ.ШиринаТаблицы,
		ОсновныеНастройки.Выбор.Элементы.Количество(), ОсновныеНастройки.Структура.Количество(),
		БазовыеНастройки.Выбор.Элементы.Количество(), БазовыеНастройки.Структура.Количество(), Лев(ТекстТаблицы(Документ), 16000)));
КонецПроцедуры

Процедура ПроверитьОтказОтчета(ИмяОтчета, Параметры, ТекстОшибки, Вывод = Ложь)
	Сообщение = "";
	Попытка
		Если Вывод Тогда
			ДокументРезультат = Сформировать(ИмяОтчета, Параметры);
		Иначе
			Данные = СервисОтчетов.ПолучитьДанные(ИмяОтчета, Параметры);
		КонецЕсли;
	Исключение
		Сообщение = ОписаниеОшибки();
	КонецПопытки;
	Убедиться(СтрНайти(Сообщение, ТекстОшибки) > 0, "Нет ожидаемой ошибки отчёта: " + Сообщение);
КонецПроцедуры

Функция ОтпечатокДанных()
	Результат = "";
	Таблицы = "Справочник.Продукты|Справочник.ВидыДокументации|Справочник.Сотрудники|Справочник.ДокументыПродуктов|Справочник.РедакцииДокументов|Документ.ПередачаНаПроверку|Документ.РезультатПроверки|Документ.ПланКомплекта|Документ.ВыпускКомплекта";
	Для Каждого Таблица Из СтрРазделить(Таблицы, "|", Ложь) Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ " + Таблица + " УПОРЯДОЧИТЬ ПО Ссылка");
		Результат = Результат + ЗначениеВСтрокуВнутр(Запрос.Выполнить().Выгрузить());
	КонецЦикла;
	Для Каждого Таблица Из СтрРазделить("Документ.ПланКомплекта.Документы|Документ.ВыпускКомплекта.Документы", "|", Ложь) Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ " + Таблица + " УПОРЯДОЧИТЬ ПО Ссылка, НомерСтроки");
		Результат = Результат + ЗначениеВСтрокуВнутр(Запрос.Выполнить().Выгрузить());
	КонецЦикла;
	Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений.СостоянияРедакций УПОРЯДОЧИТЬ ПО Период, Регистратор, НомерСтроки");
	Возврат Результат + ЗначениеВСтрокуВнутр(Запрос.Выполнить().Выгрузить());
КонецФункции

Процедура ПроверитьНачальныеПараметры(ИмяОтчета)
	Схема = СервисОтчетов.СхемаОтчета(ИмяОтчета);
	Ожидаемые = Новый Структура;
	Если ИмяОтчета = "ДокументыНаПроверке" Тогда
		Ожидаемые.Вставить("Продукт", Справочники.Продукты.ПустаяСсылка());
		Ожидаемые.Вставить("Проверяющий", Справочники.Сотрудники.ПустаяСсылка());
	Иначе
		Ожидаемые.Вставить("Редакция", Справочники.РедакцииДокументов.ПустаяСсылка());
	КонецЕсли;
	Убедиться(Схема.Параметры.Количество() = Ожидаемые.Количество(), "Потеряны начальные параметры схемы.");
	Для Каждого Параметр Из Схема.Параметры Цикл
		ПустаяСсылка = Ожидаемые[Строка(Параметр.Имя)];
		Убедиться(ТипЗнч(Параметр.Значение) = ТипЗнч(ПустаяСсылка) И Параметр.Значение = ПустаяСсылка,
			"Начальное значение схемы потеряло ссылочный тип: " + Строка(Параметр.Имя));
	КонецЦикла;
	Настройки = Схема.НастройкиПоУмолчанию;
	Убедиться(Настройки.ПараметрыДанных.Элементы.Количество() = Ожидаемые.Количество(), "Потеряны начальные параметры формы.");
	Для Каждого Параметр Из Настройки.ПараметрыДанных.Элементы Цикл
		ПустаяСсылка = Ожидаемые[Строка(Параметр.Параметр)];
		Убедиться(Параметр.Использование И ТипЗнч(Параметр.Значение) = ТипЗнч(ПустаяСсылка) И Параметр.Значение = ПустаяСсылка,
			"Начальное значение формы потеряло ссылочный тип: " + Строка(Параметр.Параметр));
	КонецЦикла;
	Если ИмяОтчета = "ДокументыНаПроверке" Тогда
		ДокументРезультат = Новый ТабличныйДокумент;
		СервисОтчетов.СформироватьПоНастройкам(ИмяОтчета, Настройки, ДокументРезультат);
		Убедиться(ДокументРезультат.ШиринаТаблицы > 2, "Очередь с начальными пустыми параметрами не сформирована.");
	Иначе
		ПроверитьОтказОтчета("ИсторияРедакции", Ожидаемые, "Выберите редакцию", Истина);
	КонецЕсли;
КонецПроцедуры


Процедура ПроверитьОтчет(Номер, Пример, Диагностика)
	Если Номер = 1 Тогда
		Данные = Очередь(Пример);
		Убедиться(Данные.Количество() = 1 И Данные[0].Редакция = Пример.НаПроверке
			И Данные[0].Передача = Пример.ОткрытаяПередача, "Очередь содержит закрытую проверку либо теряет открытую.");
		Убедиться(Данные[0].ДатаПередачи = Пример.Момент И Данные[0].Проверяющий = Пример.Проверяющий
			И Данные[0].СсылкаНаТекст = Пример.ОткрытаяПередача.СсылкаНаТекст
			И Данные[0].ИдентификаторСодержимого = Пример.ОткрытаяПередача.ИдентификаторСодержимого, "Потеряны данные передачи.");
	ИначеЕсли Номер = 2 Тогда
		Данные = СервисОтчетов.ПолучитьДанные("ДокументыНаПроверке", Новый Структура("Продукт", Пример.ДругойПродукт));
		Убедиться(Данные.Количество() = 1 И Данные[0].Редакция = Пример.ЧужаяРедакция, "Отбор по продукту неверен.");
	ИначеЕсли Номер = 3 Тогда
		Данные = СервисОтчетов.ПолучитьДанные("ДокументыНаПроверке", Новый Структура("Проверяющий", Пример.ДругойПроверяющий));
		Убедиться(Данные.Количество() = 1 И Данные[0].Передача = Пример.ДругаяПередача, "Отбор по проверяющему неверен.");
	ИначеЕсли Номер = 4 Тогда
		Решить(Пример.ОткрытаяПередача, Перечисления.РешенияПроверки.Согласовано, Пример.Момент + 1);
		Убедиться(Очередь(Пример).Количество() = 0, "Согласованная редакция остаётся в очереди.");
	ИначеЕсли Номер = 5 Тогда
		Решить(Пример.ОткрытаяПередача, Перечисления.РешенияПроверки.НаДоработку, Пример.Момент + 1, "RP: дополнить пример.");
		Убедиться(Очередь(Пример).Количество() = 0, "Возврат на доработку остался в очереди.");
	ИначеЕсли Номер = 6 Тогда
		Решение = Пример.Решения[0].ПолучитьОбъект(); Решение.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Данные = Очередь(Пример);
		Убедиться(Данные.Количество() = 2 И История(Пример.Согласованные[0]).Количество() = 1, "Отмена решения не восстановила очередь и историю.");
	ИначеЕсли Номер = 7 Тогда
		Передача = Пример.ОткрытаяПередача.ПолучитьОбъект(); Передача.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Убедиться(Очередь(Пример).Количество() = 0 И История(Пример.НаПроверке).Количество() = 0, "Отменённая передача осталась в отчёте.");
	ИначеЕсли Номер = 8 Тогда
		Решить(Пример.ОткрытаяПередача, Перечисления.РешенияПроверки.НаДоработку, Пример.Момент + 1, "RP: уточнить раздел.");
		Передача = Передать(Пример.НаПроверке, Пример, Пример.Момент + 2);
		Решение = Решить(Передача, Перечисления.РешенияПроверки.Согласовано, Пример.Момент + 3);
		Данные = История(Пример.НаПроверке);
		Убедиться(Данные.Количество() = 4 И Данные[3].Событие = Решение И Данные[2].Событие = Передача, "Повторная проверка потеряла события.");
		Убедиться(Данные[0].ДатаСобытия < Данные[1].ДатаСобытия И Данные[1].ДатаСобытия < Данные[2].ДатаСобытия
			И Данные[2].ДатаСобытия < Данные[3].ДатаСобытия И Очередь(Пример).Количество() = 0, "Нарушена хронология или текущее состояние.");
	ИначеЕсли Номер = 9 Тогда
		Данные = История(Пример.Согласованные[0]);
		Убедиться(Данные.Количество() = 2 И Данные[0].Событие = Пример.Передачи[0] И Данные[1].Событие = Пример.Решения[0]
			И Данные[1].Состояние = Перечисления.СостоянияРедакции.Согласована, "История не совпадает с основаниями согласования.");
		Для Каждого Запись Из Данные Цикл
			Убедиться(Запись.Передача = Пример.Передачи[0] И Запись.Проверяющий = Пример.Проверяющий
				И Запись.СсылкаНаТекст = Пример.Передачи[0].СсылкаНаТекст
				И Запись.ИдентификаторСодержимого = Пример.Передачи[0].ИдентификаторСодержимого, "История потеряла проверенный текст.");
		КонецЦикла;
	ИначеЕсли Номер = 10 Тогда
		Данные = История(Пример.НаДоработке);
		Убедиться(Данные.Количество() = 2 И Данные[1].Состояние = Перечисления.СостоянияРедакции.НаДоработке
			И Данные[1].Замечание = "Уточнить шаги установки.", "Потеряно замечание проверяющего.");
	ИначеЕсли Номер = 11 Тогда
		Убедиться(История(Пример.НоваяРедакция).Количество() = 0, "Черновик унаследовал историю другой редакции.");
		Данные = История(Пример.ЧужаяРедакция);
		Убедиться(Данные.Количество() = 1 И Данные[0].Событие = Пример.ДругаяПередача, "Смешаны истории разных продуктов.");
	ИначеЕсли Номер = 12 Тогда
		ПроверитьОтказОтчета("ИсторияРедакции", Неопределено, "Выберите редакцию");
		ПроверитьОтказОтчета("ИсторияРедакции", Неопределено, "Выберите редакцию", Истина);
	ИначеЕсли Номер = 13 Тогда
		Передача = Документы.ПередачаНаПроверку.СоздатьДокумент(); Передача.Дата = Пример.Момент;
		Передача.Редакция = Пример.НоваяРедакция; Передача.Проверяющий = Пример.Проверяющий; Передача.Записать();
		Решение = Документы.РезультатПроверки.СоздатьДокумент(); Решение.Дата = Пример.Момент + 1;
		Решение.Передача = Пример.ОткрытаяПередача; Решение.Проверяющий = Пример.Проверяющий;
		Решение.Решение = Перечисления.РешенияПроверки.Согласовано; Решение.Записать();
		Убедиться(Очередь(Пример).Количество() = 1 И История(Пример.НоваяРедакция).Количество() = 0
			И История(Пример.НаПроверке).Количество() = 1, "Черновые события повлияли на отчёты.");
	ИначеЕсли Номер = 14 Тогда
		Передача = Пример.ОткрытаяПередача.ПолучитьОбъект();
		Передача.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Передача.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Убедиться(Очередь(Пример).Количество() = 1 И История(Пример.НаПроверке).Количество() = 1, "Перепроведение удвоило строки.");
	ИначеЕсли Номер = 15 Тогда
		Убедиться(Очередь(Пример, Пример.ДругойПроверяющий).Количество() = 0, "Совместный отбор потерял одно условие.");
		ПроверитьОтказОтчета("ИсторияРедакции", Новый Структура("Редакция", Пример.Продукт), "Неверный тип параметра");
		ПроверитьОтказОтчета("ДокументыНаПроверке", Новый Структура("Продукт", "RP"), "Неверный тип параметра");
	ИначеЕсли Номер = 16 Тогда
		ПроверитьНачальныеПараметры("ДокументыНаПроверке");
		Документ = Сформировать("ДокументыНаПроверке", Новый Структура("Продукт", Пример.Продукт)); Текст = ТекстТаблицы(Документ);
		ДобавитьДиагностикуВывода(Диагностика, "ДокументыНаПроверке", Новый Структура("Продукт", Пример.Продукт), Документ, "queue_one_row");
		Убедиться(СтрНайти(Текст, "Инструкция установки — пример отчётов") > 0
			И ЕстьЯчейка(Документ, "1.1") И Не ЕстьЯчейка(Документ, "1.2")
			И СтрНайти(Текст, "Документ другого продукта") = 0, "Вывод СКД не совпал с отобранной очередью.");
		Документ = Сформировать("ДокументыНаПроверке", Новый Структура("Продукт,Проверяющий", Пример.Продукт, Пример.ДругойПроверяющий));
		ДобавитьДиагностикуВывода(Диагностика, "ДокументыНаПроверке", Новый Структура("Продукт,Проверяющий", Пример.Продукт, Пример.ДругойПроверяющий), Документ, "queue_empty");
		Убедиться(СтрНайти(ТекстТаблицы(Документ), "Инструкция установки — пример отчётов") = 0, "Пустая очередь показывает прежние данные.");
	ИначеЕсли Номер = 17 Тогда
		ПроверитьНачальныеПараметры("ИсторияРедакции");
		Документ = Сформировать("ИсторияРедакции", Новый Структура("Редакция", Пример.НаДоработке)); Текст = ТекстТаблицы(Документ);
		ДобавитьДиагностикуВывода(Диагностика, "ИсторияРедакции", Новый Структура("Редакция", Пример.НаДоработке), Документ, "history_two_events");
		Убедиться(СтрНайти(Текст, "Уточнить шаги установки.") > 0 И СтрНайти(Текст, "На доработке") > 0
			И СтрНайти(Текст, "На проверке") > 0, "Вывод истории потерял состояние или замечание.");
		Документ = Сформировать("ИсторияРедакции", Новый Структура("Редакция", Пример.НоваяРедакция));
		ДобавитьДиагностикуВывода(Диагностика, "ИсторияРедакции", Новый Структура("Редакция", Пример.НоваяРедакция), Документ, "history_empty");
		Убедиться(СтрНайти(ТекстТаблицы(Документ), "Уточнить шаги установки.") = 0, "Пустая история содержит чужое замечание.");
	ИначеЕсли Номер = 18 Тогда
		До = ОтпечатокДанных();
		Данные = Очередь(Пример); Данные = История(Пример.Согласованные[0]);
		Документ = Сформировать("ДокументыНаПроверке", Новый Структура("Продукт", Пример.Продукт));
		Документ = Сформировать("ИсторияРедакции", Новый Структура("Редакция", Пример.Согласованные[0]));
		Убедиться(ОтпечатокДанных() = До, "Формирование отчёта изменило прикладные данные.");
	КонецЕсли;
КонецПроцедуры

Процедура ЗапуститьПроверкиОтчетов(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска) Экспорт
	ПраваДокументации.ТребоватьАдминистратора();
	ПроверкиВыпуска.ЗапуститьПроверкиВыпуска(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска);
	Информация = Новый СистемнаяИнформация;
	Результат = Новый Структура("phase,version,run_id,source_digest,platform_version,status,tests,passed_count,failed_count,error",
		"milestone_6_reports_runtime", "0.7.0-dev", ИдентификаторЗапуска, ХешИсходников, Информация.ВерсияПриложения, "FAIL", Новый Массив, 0, 0, "");
	Результат.Вставить("manual_UI", "PENDING");
	Попытка
		Пример = СоздатьПример(ПапкаЗапуска);
		Пример.Вставить("ДругойПроверяющий", НовыйЭлемент(Справочники.Сотрудники, "RP-REVIEWER-2", "Второй проверяющий отчётов", Новый Структура));
		ДругойПример = Новый Структура("Проверяющий", Пример.ДругойПроверяющий);
		Пример.Вставить("ДругаяПередача", Передать(Пример.ЧужаяРедакция, ДругойПример, Пример.Момент));
		Для Номер = 1 По 18 Цикл
			Проверка = Новый Структура("id,status,error", "RP-" + Прав("0" + Строка(Номер), 2), "FAIL", "");
			Проверка.Вставить("diagnostics", Новый Массив);
			До = ОтпечатокДанных();
			Попытка
				НачатьТранзакцию(); ПроверитьОтчет(Номер, Пример, Проверка.diagnostics);
				Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
				Убедиться(ОтпечатокДанных() = До, "После проверки остались изменения.");
				Проверка.status = "PASS"; Результат.passed_count = Результат.passed_count + 1;
			Исключение
				Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
				Проверка.error = ОписаниеОшибки(); Результат.failed_count = Результат.failed_count + 1;
			КонецПопытки;
			Результат.tests.Добавить(Проверка);
		КонецЦикла;
		Результат.Вставить("demo_product", Строка(Пример.Продукт));
		Результат.Вставить("demo_history_edition", Строка(Пример.НаДоработке));
		Результат.Вставить("expected_queue_rows", 1); Результат.Вставить("expected_history_rows", 2);
		Если Результат.failed_count = 0 Тогда Результат.status = "PASS"; КонецЕсли;
	Исключение
		Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
		Результат.error = ОписаниеОшибки(); Результат.failed_count = Результат.failed_count + 1;
	КонецПопытки;
	Запись = Новый ЗаписьJSON; Запись.ОткрытьФайл(ПапкаЗапуска + "\reports-tests.json"); ЗаписатьJSON(Запись, Результат); Запись.Закрыть();
КонецПроцедуры
