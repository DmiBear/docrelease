Функция ПолучитьИлиСоздать(Менеджер, Код, Название, Реквизиты)

	Ссылка = Менеджер.НайтиПоКоду(Код);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Элемент = Менеджер.СоздатьЭлемент();
	Элемент.Код = Код;
	Элемент.Наименование = Название;
	Для Каждого Реквизит Из Реквизиты Цикл
		Элемент[Реквизит.Ключ] = Реквизит.Значение;
	КонецЦикла;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

Функция СоздатьДемонстрационныйПример(КореньПроекта, ХешТекста)

	НачатьТранзакцию();
	Попытка
		Продукт = ПолучитьИлиСоздать(Справочники.Продукты, "DR-PRODUCT", "DocRelease",
			Новый Структура("Описание", "Первый учебный прототип: учёт документов и редакций"));
		Вид = ПолучитьИлиСоздать(Справочники.ВидыДокументации, "DR-GUIDE", "Руководство пользователя", Новый Структура);
		Автор = ПолучитьИлиСоздать(Справочники.Сотрудники, "DR-AUTHOR", "Демонстрационный автор", Новый Структура);
		Документ = ПолучитьИлиСоздать(Справочники.ДокументыПродуктов, "DR-DOC", "Пример руководства DocRelease",
			Новый Структура("Продукт,ВидДокументации", Продукт, Вид));
		СсылкаНаТекст = "file:///" + СтрЗаменить(КореньПроекта + "examples\demo-guide.md", "\", "/");
		Редакция = ПолучитьИлиСоздать(Справочники.РедакцииДокументов, "DR-REV", "Пример руководства / 1.0",
			Новый Структура("ДокументПродукта,НомерРедакции,Автор,СсылкаНаТекст,ИдентификаторСодержимого",
				Документ, "1.0", Автор, СсылкаНаТекст, ХешТекста));
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Новый Структура("Продукт,Вид,Автор,Документ,Редакция,СсылкаНаТекст", Продукт, Вид, Автор, Документ, Редакция, СсылкаНаТекст);

КонецФункции

Процедура ПроверитьУсловие(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция НоваяПробнаяРедакция(Пример, Номер)
	Объект = Справочники.РедакцииДокументов.СоздатьЭлемент();
	Объект.ДокументПродукта = Пример.Документ;
	Объект.НомерРедакции = Номер;
	Объект.Автор = Пример.Автор;
	Объект.СсылкаНаТекст = Пример.Редакция.СсылкаНаТекст;
	Объект.ИдентификаторСодержимого = Пример.Редакция.ИдентификаторСодержимого;
	Возврат Объект;
КонецФункции

Процедура ПроверитьОтклонение(Объект, ФрагментПричины)
	Отклонено = Ложь;
	НачатьТранзакцию();
	Попытка
		Объект.Записать();
	Исключение
		Отклонено = СтрНайти(ОписаниеОшибки(), ФрагментПричины) > 0;
	КонецПопытки;
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
	ПроверитьУсловие(Отклонено, "Операция не отклонена по ожидаемой причине: " + ФрагментПричины);
КонецПроцедуры

Процедура ВыполнитьСценарий(Номер, Пример, ХешТекста)

	Если Номер = 1 Тогда
		Прочитанная = Пример.Редакция.ПолучитьОбъект();
		ПроверитьУсловие(Прочитанная.ДокументПродукта = Пример.Документ, "Не сохранена связь редакции с документом.");
		ПроверитьУсловие(Прочитанная.ДокументПродукта.Продукт = Пример.Продукт, "Не сохранена связь документа с продуктом.");
		ПроверитьУсловие(Прочитанная.НомерРедакции = "1.0", "Не сохранён номер редакции.");
		ПроверитьУсловие(Прочитанная.Автор = Пример.Автор, "Не сохранён автор редакции.");
		ПроверитьУсловие(Прочитанная.СсылкаНаТекст = Пример.СсылкаНаТекст, "Не сохранена ссылка на демонстрационный текст.");
		ПроверитьУсловие(Прочитанная.ИдентификаторСодержимого = ХешТекста, "Идентификатор текста не совпадает с контрольной суммой примера.");
	ИначеЕсли Номер = 2 Тогда
		ПроверитьОтклонение(НоваяПробнаяРедакция(Пример, "1.0"), "уже существует редакция с таким номером");
	ИначеЕсли Номер = 3 Тогда
		ПроверитьОтклонение(НоваяПробнаяРедакция(Пример, ""), "Укажите номер редакции");
	ИначеЕсли Номер = 4 Тогда
		Объект = Пример.Редакция.ПолучитьОбъект();
		Объект.Записать();
		ПроверитьУсловие(Объект.Ссылка = Пример.Редакция, "Повторная запись создала другую редакцию.");
	ИначеЕсли Номер = 5 Тогда
		Объект = НоваяПробнаяРедакция(Пример, "2.0");
		Объект.СсылкаНаТекст = "";
		ПроверитьОтклонение(Объект, "Укажите ссылку на текст редакции");
	ИначеЕсли Номер = 6 Тогда
		ПроверитьОтклонение(НоваяПробнаяРедакция(Пример, " 1.0 "), "уже существует редакция с таким номером");
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьИПроверитьПрототип(КореньПроекта, ХешТекста, ИдентификаторЗапуска) Экспорт
	ПраваДокументации.ТребоватьАдминистратора();

	Если Прав(КореньПроекта, 1) <> "\" Тогда
		КореньПроекта = КореньПроекта + "\";
	КонецЕсли;
	ФайлПримера = Новый Файл(КореньПроекта + "examples\demo-guide.md");
	ПроверитьУсловие(ФайлПримера.Существует(), "Не найден демонстрационный текст.");
	ПроверитьУсловие(СтрДлина(ХешТекста) = 64, "Не получена контрольная сумма демонстрационного текста.");

	Результат = Новый Структура;
	Результат.Вставить("phase", "milestone_1_runtime");
	Результат.Вставить("version", "0.1.0-dev");
	Результат.Вставить("run_id", ИдентификаторЗапуска);
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	Результат.Вставить("platform_version", ИнформацияОСистеме.ВерсияПриложения);
	Результат.Вставить("status", "FAIL");
	Результат.Вставить("tests", Новый Массив);
	Результат.Вставить("passed_count", 0);
	Результат.Вставить("failed_count", 0);
	Результат.Вставить("demo_sha256", ХешТекста);
	Результат.Вставить("error", "");

	Попытка
		Пример = СоздатьДемонстрационныйПример(КореньПроекта, ХешТекста);
		Названия = Новый Массив;
		Названия.Добавить("Сохранение и чтение связанного примера");
		Названия.Добавить("Отклонение повторного номера редакции");
		Названия.Добавить("Отклонение пустого номера редакции");
		Названия.Добавить("Повторная запись существующей редакции");
		Названия.Добавить("Отклонение пустой ссылки на текст");
		Названия.Добавить("Проверка дубля после удаления внешних пробелов");
		Для Номер = 1 По 6 Цикл
			Проверка = Новый Структура("id,name,status,error", "SM-0" + Строка(Номер), Названия[Номер - 1], "FAIL", "");
			Попытка
				ВыполнитьСценарий(Номер, Пример, ХешТекста);
				Проверка.status = "PASS";
				Результат.passed_count = Результат.passed_count + 1;
			Исключение
				Проверка.error = ОписаниеОшибки();
				Результат.failed_count = Результат.failed_count + 1;
			КонецПопытки;
			Результат.tests.Добавить(Проверка);
		КонецЦикла;
		Если Результат.failed_count = 0 Тогда
			Результат.status = "PASS";
		КонецЕсли;
	Исключение
		Результат.error = ОписаниеОшибки();
		Результат.failed_count = Результат.failed_count + 1;
	КонецПопытки;

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(КореньПроекта + ".local\prototype-run\prototype-smoke.json");
	ЗаписатьJSON(Запись, Результат);
	Запись.Закрыть();

КонецПроцедуры
