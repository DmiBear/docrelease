// Независимые данные этапа 3. Вызывается загрузчиком только на отдельной копии базы.
Процедура Проверить(Условие, Причина)
	Если Не Условие Тогда
		ВызватьИсключение Причина;
	КонецЕсли;
КонецПроцедуры

Функция НовыйЭлемент(Менеджер, Код, Название, Реквизиты)
	Проверить(Менеджер.НайтиПоКоду(Код).Пустая(), "В проверочной базе уже есть код " + Код);
	Элемент = Менеджер.СоздатьЭлемент();
	Элемент.Код = Код;
	Элемент.Наименование = Название;
	Для Каждого Поле Из Реквизиты Цикл
		Элемент[Поле.Ключ] = Поле.Значение;
	КонецЦикла;
	Элемент.Записать();
	Возврат Элемент.Ссылка;
КонецФункции

Функция СоздатьПример()
	НачатьТранзакцию();
	Попытка
		Продукт = НовыйЭлемент(Справочники.Продукты, "P4-PRODUCT", "DocRelease — пример плана",
			Новый Структура("Описание", "Проверочные данные этапа 3 в отдельной копии базы"));
		ДругойПродукт = НовыйЭлемент(Справочники.Продукты, "P4-OTHER", "Другой проверочный продукт", Новый Структура);
		Куратор = НовыйЭлемент(Справочники.Сотрудники, "P4-CURATOR", "Куратор проверочного комплекта", Новый Структура);
		Ответственный = НовыйЭлемент(Справочники.Сотрудники, "P4-WRITER", "Автор проверочных документов", Новый Структура);
		Виды = Новый Массив;
		Виды.Добавить("Руководство пользователя");
		Виды.Добавить("Инструкция установки");
		Виды.Добавить("Описание изменений");
		СписокДокументов = Новый Массив;
		Для Номер = 1 По 3 Цикл
			Вид = НовыйЭлемент(Справочники.ВидыДокументации, "P4-TYPE-" + Строка(Номер), Виды[Номер - 1], Новый Структура);
			ДокументПродукта = НовыйЭлемент(Справочники.ДокументыПродуктов, "P4-DOC-" + Строка(Номер),
				Виды[Номер - 1] + " DocRelease 1.0", Новый Структура("Продукт,ВидДокументации", Продукт, Вид));
			СписокДокументов.Добавить(ДокументПродукта);
		КонецЦикла;
		ЧужойДокумент = НовыйЭлемент(Справочники.ДокументыПродуктов, "P4-FOREIGN", "Документ другого продукта",
			Новый Структура("Продукт,ВидДокументации", ДругойПродукт, Вид));
		Пример = Новый Структура("Продукт,ДругойПродукт,Куратор,Ответственный,СписокДокументов,ЧужойДокумент",
			Продукт, ДругойПродукт, Куратор, Ответственный, СписокДокументов, ЧужойДокумент);
		План = НовыйПлан(Пример);
		План.Записать();
		Пример.Вставить("План", План.Ссылка);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Возврат Пример;
КонецФункции

Функция НовыйПлан(Пример)
	План = Документы.ПланКомплекта.СоздатьДокумент();
	План.Дата = ТекущаяДата();
	План.Продукт = Пример.Продукт;
	План.НомерРелиза = " 1.0 ";
	План.Куратор = Пример.Куратор;
	Для Каждого ДокументПродукта Из Пример.СписокДокументов Цикл
		СтрокаПлана = План.Документы.Добавить();
		СтрокаПлана.ДокументПродукта = ДокументПродукта;
		СтрокаПлана.Ответственный = Пример.Ответственный;
		СтрокаПлана.СрокПодготовки = НачалоДня(ТекущаяДата()) + 7 * 24 * 60 * 60;
	КонецЦикла;
	Возврат План;
КонецФункции

Функция КоличествоПланов()
	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.ПланКомплекта КАК План");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;
КонецФункции

Процедура ПроверитьОтклонение(План, ОжидаемаяПричина)
	КоличествоДо = КоличествоПланов();
	Причина = "";
	НачатьТранзакцию();
	Попытка
		План.Записать();
	Исключение
		Причина = ОписаниеОшибки();
	КонецПопытки;
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
	Проверить(СтрНайти(Причина, ОжидаемаяПричина) > 0,
		"Запись не отклонена по ожидаемой причине: " + ОжидаемаяПричина + ". Получено: " + Причина);
	Проверить(КоличествоДо = КоличествоПланов(), "Неудачная запись изменила количество планов.");
КонецПроцедуры

Процедура ВыполнитьСценарий(Номер, Пример)
	Если Номер = 1 Тогда
		НачатьТранзакцию();
		Попытка
			План = НовыйПлан(Пример);
			План.Записать();
			Прочитанный = План.Ссылка.ПолучитьОбъект();
			Проверить(ЗначениеЗаполнено(Прочитанный.Номер), "Не присвоен номер плана.");
			Проверить(Прочитанный.Продукт = Пример.Продукт, "Не сохранён продукт.");
			Проверить(Прочитанный.НомерРелиза = "1.0", "Не удалены внешние пробелы номера релиза.");
			Проверить(Прочитанный.Куратор = Пример.Куратор, "Не сохранён куратор.");
			Проверить(Прочитанный.Документы.Количество() = 3, "Не сохранены три строки плана.");
			Для Индекс = 0 По 2 Цикл
				СтрокаПлана = Прочитанный.Документы[Индекс];
				Проверить(СтрокаПлана.ДокументПродукта = Пример.СписокДокументов[Индекс], "Изменилась связь с документом.");
				Проверить(СтрокаПлана.Ответственный = Пример.Ответственный, "Не сохранён ответственный.");
				Проверить(СтрокаПлана.СрокПодготовки = План.Документы[Индекс].СрокПодготовки, "Не сохранён срок.");
			КонецЦикла;
			ОтменитьТранзакцию();
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ВызватьИсключение;
		КонецПопытки;
	ИначеЕсли Номер = 2 Тогда
		План = НовыйПлан(Пример);
		План.Документы.Очистить();
		ПроверитьОтклонение(План, "Добавьте хотя бы один документ");
	ИначеЕсли Номер = 3 Тогда
		План = НовыйПлан(Пример);
		План.Документы[1].ДокументПродукта = План.Документы[0].ДокументПродукта;
		ПроверитьОтклонение(План, "документ уже включён");
	ИначеЕсли Номер = 4 Тогда
		План = НовыйПлан(Пример);
		План.Документы[0].ДокументПродукта = Пример.ЧужойДокумент;
		ПроверитьОтклонение(План, "документ относится к другому продукту");
		План = Пример.План.ПолучитьОбъект();
		План.Продукт = Пример.ДругойПродукт;
		ПроверитьОтклонение(План, "документ относится к другому продукту");
		Проверить(Пример.План.ПолучитьОбъект().Продукт = Пример.Продукт, "Неудачное изменение подменило продукт сохранённого плана.");
	ИначеЕсли Номер = 5 Тогда
		Поля = Новый Массив;
		Поля.Добавить(Новый Структура("Имя,ПустоеЗначение,Причина", "Продукт", Справочники.Продукты.ПустаяСсылка(), "Укажите продукт"));
		Поля.Добавить(Новый Структура("Имя,ПустоеЗначение,Причина", "НомерРелиза", "", "Укажите номер релиза"));
		Поля.Добавить(Новый Структура("Имя,ПустоеЗначение,Причина", "НомерРелиза", "   ", "Укажите номер релиза"));
		Поля.Добавить(Новый Структура("Имя,ПустоеЗначение,Причина", "Куратор", Справочники.Сотрудники.ПустаяСсылка(), "Укажите куратора"));
		Для Каждого Поле Из Поля Цикл
			План = НовыйПлан(Пример);
			План[Поле.Имя] = Поле.ПустоеЗначение;
			ПроверитьОтклонение(План, Поле.Причина);
		КонецЦикла;
		Поля.Очистить();
		Поля.Добавить(Новый Структура("Имя,ПустоеЗначение,Причина", "ДокументПродукта", Справочники.ДокументыПродуктов.ПустаяСсылка(), "укажите документ продукта"));
		Поля.Добавить(Новый Структура("Имя,ПустоеЗначение,Причина", "Ответственный", Справочники.Сотрудники.ПустаяСсылка(), "укажите ответственного"));
		Поля.Добавить(Новый Структура("Имя,ПустоеЗначение,Причина", "СрокПодготовки", Дата(1, 1, 1), "укажите срок подготовки"));
		Для Каждого Поле Из Поля Цикл
			План = НовыйПлан(Пример);
			План.Документы[0][Поле.Имя] = Поле.ПустоеЗначение;
			ПроверитьОтклонение(План, Поле.Причина);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ЗапуститьПроверкиПлана(ПапкаЗапуска, ХешИсходников, ИдентификаторЗапуска) Экспорт
	ПраваДокументации.ТребоватьАдминистратора();
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	Результат = Новый Структура("phase,version,run_id,source_digest,platform_version,status,tests,passed_count,failed_count,error",
		"milestone_3_plan_runtime", "0.7.0-dev", ИдентификаторЗапуска, ХешИсходников,
		ИнформацияОСистеме.ВерсияПриложения, "FAIL", Новый Массив, 0, 0, "");
	Результат.Вставить("manual_PL06", "PENDING");
	Попытка
		Пример = СоздатьПример();
		Результат.Вставить("demo_plan", Строка(Пример.План));
		Названия = Новый Массив;
		Названия.Добавить("Сохранение и чтение трёх документов, ответственных и сроков");
		Названия.Добавить("Отклонение пустого состава");
		Названия.Добавить("Отклонение повторного документа");
		Названия.Добавить("Другой продукт и изменение продукта сохранённого плана");
		Названия.Добавить("Семь вариантов незаполненных полей карточки и строк");
		Для Номер = 1 По 5 Цикл
			Проверка = Новый Структура("id,name,status,error", "P4-0" + Строка(Номер), Названия[Номер - 1], "FAIL", "");
			Попытка
				ВыполнитьСценарий(Номер, Пример);
				Проверка.status = "PASS";
				Результат.passed_count = Результат.passed_count + 1;
			Исключение
				Проверка.error = ОписаниеОшибки();
				Результат.failed_count = Результат.failed_count + 1;
			КонецПопытки;
			Результат.tests.Добавить(Проверка);
		КонецЦикла;
		Если Результат.failed_count = 0 Тогда
			Результат.status = "PASS";
		КонецЕсли;
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Результат.error = ОписаниеОшибки();
		Результат.failed_count = Результат.failed_count + 1;
	КонецПопытки;
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПапкаЗапуска + "\plan-tests.json");
	ЗаписатьJSON(Запись, Результат);
	Запись.Закрыть();
КонецПроцедуры
