// Снимок заполняется в ПередЗаписью и повторно проверяется в ОбработкеПроведения.
// Оба обработчика объекта выполняются внутри транзакции записи документа.
Функция ПоляКарточки()
	Возврат СтрРазделить("Продукт,НомерРелиза,Куратор", ",", Ложь);
КонецФункции

Функция ПоляСтроки()
	Возврат СтрРазделить("ДокументПродукта,Редакция,НомерРедакции,Ответственный,СрокПодготовки,СсылкаНаТекст,ИдентификаторСодержимого,Передача,РешениеПроверки,Проверяющий,ДатаСогласования", ",", Ложь);
КонецФункции

Функция СовпадаетСнимок(Первый, Второй) Экспорт
	Для Каждого Поле Из ПоляКарточки() Цикл
		Если Первый[Поле] <> Второй[Поле] Тогда Возврат Ложь; КонецЕсли;
	КонецЦикла;
	Если Первый.Документы.Количество() <> Второй.Документы.Количество() Тогда Возврат Ложь; КонецЕсли;
	Для Индекс = 0 По Первый.Документы.Количество() - 1 Цикл
		Для Каждого Поле Из ПоляСтроки() Цикл
			Если Первый.Документы[Индекс][Поле] <> Второй.Документы[Индекс][Поле] Тогда Возврат Ложь; КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ПроверитьЗависимость(СсылкаОбъекта) Экспорт
	Если Не ЗначениеЗаполнено(СсылкаОбъекта) Тогда Возврат; КонецЕсли;
	Запрос = Новый Запрос;
	Если ТипЗнч(СсылкаОбъекта) = Тип("ДокументСсылка.ПланКомплекта") Тогда
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Выпуски.Ссылка
		|ИЗ Документ.ВыпускКомплекта КАК Выпуски
		|ГДЕ Выпуски.ПланКомплекта = &Объект И Выпуски.Проведен";
	Иначе
		Если ТипЗнч(СсылкаОбъекта) = Тип("СправочникСсылка.РедакцииДокументов") Тогда
			Поле = "Редакция";
		ИначеЕсли ТипЗнч(СсылкаОбъекта) = Тип("СправочникСсылка.ДокументыПродуктов") Тогда
			Поле = "ДокументПродукта";
		ИначеЕсли ТипЗнч(СсылкаОбъекта) = Тип("ДокументСсылка.ПередачаНаПроверку") Тогда
			Поле = "Передача";
		ИначеЕсли ТипЗнч(СсылкаОбъекта) = Тип("ДокументСсылка.РезультатПроверки") Тогда
			Поле = "РешениеПроверки";
		Иначе
			ВызватьИсключение "Неизвестный тип основания выпуска.";
		КонецЕсли;
		// Имя поля выбирается только из констант, не из пользовательского текста.
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Состав.Ссылка
		|ИЗ Документ.ВыпускКомплекта.Документы КАК Состав
		|ГДЕ Состав." + Поле + " = &Объект И Состав.Ссылка.Проведен";
	КонецЕсли;
	Запрос.УстановитьПараметр("Объект", СсылкаОбъекта);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Объект используется в проведённом выпуске. Сначала отмените выпуск комплекта.";
	КонецЕсли;
КонецПроцедуры

Функция ПрочитатьГотовыйПлан(Выпуск)
	Если Не ЗначениеЗаполнено(Выпуск.ПланКомплекта) Тогда
		ВызватьИсключение "Выберите сохранённый план комплекта для выпуска.";
	КонецЕсли;
	Если Выпуск.ПометкаУдаления Тогда
		ВызватьИсключение "Нельзя провести выпуск, помеченный на удаление.";
	КонецЕсли;
	План = Выпуск.ПланКомплекта.ПолучитьОбъект();
	Если План = Неопределено Тогда ВызватьИсключение "План комплекта не найден."; КонецЕсли;
	Если План.ПометкаУдаления Тогда ВызватьИсключение "План комплекта помечен на удаление."; КонецЕсли;
	Оценка = ГотовностьКомплектов.РассчитатьПоДаннымПлана(План);
	Если Не Оценка.Готов Тогда
		Причины = Новый Массив;
		Для Каждого Причина Из Оценка.Причины Цикл
			Префикс = "План: ";
			Если Причина.НомерСтроки > 0 Тогда Префикс = "Строка " + Строка(Причина.НомерСтроки) + ": "; КонецЕсли;
			Причины.Добавить(Префикс + Причина.Текст);
		КонецЦикла;
		ВызватьИсключение "Выпуск запрещён: комплект не готов." + Символы.ПС + СтрСоединить(Причины, Символы.ПС);
	КонецЕсли;
	Для Каждого СтрокаПлана Из План.Документы Цикл
		Состояние = КонтрольДокументации.ПолучитьСостояние(СтрокаПлана.Редакция);
		Если Выпуск.Дата < Состояние.Период Тогда
			ВызватьИсключение "Дата выпуска не может быть раньше согласования выбранных редакций.";
		КонецЕсли;
	КонецЦикла;
	Возврат План;
КонецФункции

Процедура ЗаполнитьСнимок(Выпуск, План)
	Для Каждого Поле Из ПоляКарточки() Цикл Выпуск[Поле] = План[Поле]; КонецЦикла;
	Выпуск.Документы.Очистить();
	Для Каждого СтрокаПлана Из План.Документы Цикл
		Редакция = СтрокаПлана.Редакция.ПолучитьОбъект();
		Состояние = КонтрольДокументации.ПолучитьСостояние(Редакция.Ссылка);
		СтрокаВыпуска = Выпуск.Документы.Добавить();
		Для Каждого Поле Из СтрРазделить("ДокументПродукта,Редакция,Ответственный,СрокПодготовки", ",", Ложь) Цикл
			СтрокаВыпуска[Поле] = СтрокаПлана[Поле];
		КонецЦикла;
		СтрокаВыпуска.НомерРедакции = Редакция.НомерРедакции;
		СтрокаВыпуска.СсылкаНаТекст = Редакция.СсылкаНаТекст;
		СтрокаВыпуска.ИдентификаторСодержимого = Редакция.ИдентификаторСодержимого;
		СтрокаВыпуска.Передача = Состояние.Передача;
		СтрокаВыпуска.РешениеПроверки = Состояние.Регистратор;
		СтрокаВыпуска.Проверяющий = Состояние.Проверяющий;
		СтрокаВыпуска.ДатаСогласования = Состояние.Период;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьСнимокПоПлану(Выпуск, План)
	Ожидаемый = Документы.ВыпускКомплекта.СоздатьДокумент();
	ЗаполнитьСнимок(Ожидаемый, План);
	Если Не СовпадаетСнимок(Выпуск, Ожидаемый) Тогда
		ВызватьИсключение "Состав выпуска не совпадает с сохранённым планом и действующими согласованиями.";
	КонецЕсли;
КонецПроцедуры

Процедура ПодготовитьЗапись(Выпуск, РежимЗаписи) Экспорт
	БылПроведён = Ложь;
	Если Не Выпуск.ЭтоНовый() Тогда
		Прежний = Выпуск.Ссылка.ПолучитьОбъект(); БылПроведён = Прежний.Проведен;
	КонецЕсли;
	Если БылПроведён Тогда
		Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			ВызватьИсключение "Сначала отмените проведение выпуска. Изменение зафиксированного состава запрещено.";
		КонецЕсли;
		Если Выпуск.Дата <> Прежний.Дата Или Выпуск.Номер <> Прежний.Номер
			Или Выпуск.ПланКомплекта <> Прежний.ПланКомплекта
			Или Выпуск.ПометкаУдаления <> Прежний.ПометкаУдаления
			Или Не СовпадаетСнимок(Выпуск, Прежний) Тогда
			ВызватьИсключение "При перепроведении или отмене выпуска не изменяйте реквизиты и зафиксированный состав.";
		КонецЕсли;
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		План = ПрочитатьГотовыйПлан(Выпуск);
		Если БылПроведён Тогда
			ПроверитьСнимокПоПлану(Выпуск, План);
		Иначе
			// Данные строки из клиента не принимаются как основание выпуска.
			ЗаполнитьСнимок(Выпуск, План);
		КонецЕсли;
	ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		// У черновика снимка ещё нет. Он формируется только при проведении.
		Выпуск.Продукт = Справочники.Продукты.ПустаяСсылка(); Выпуск.НомерРелиза = "";
		Выпуск.Куратор = Справочники.Сотрудники.ПустаяСсылка(); Выпуск.Документы.Очистить();
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПроведение(Выпуск) Экспорт
	// Повторное серверное чтение в обработчике проведения. Ранее открытый отчёт не используется.
	План = ПрочитатьГотовыйПлан(Выпуск);
	ПроверитьСнимокПоПлану(Выпуск, План);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Выпуски.Ссылка
	|ИЗ Документ.ВыпускКомплекта КАК Выпуски
	|ГДЕ Выпуски.Проведен И Выпуски.Ссылка <> &Текущий
	| И (Выпуски.ПланКомплекта = &План
	| ИЛИ (Выпуски.Продукт = &Продукт И Выпуски.НомерРелиза = &НомерРелиза))");
	Запрос.УстановитьПараметр("Текущий", Выпуск.Ссылка);
	Запрос.УстановитьПараметр("План", Выпуск.ПланКомплекта);
	Запрос.УстановитьПараметр("Продукт", План.Продукт);
	Запрос.УстановитьПараметр("НомерРелиза", План.НомерРелиза);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Для этого плана или продукта и номера релиза уже существует проведённый выпуск.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьУдалениеВыпуска(Выпуск) Экспорт
	Если Выпуск.Проведен Тогда ВызватьИсключение "Перед удалением сначала отмените проведение выпуска."; КонецЕсли;
КонецПроцедуры
