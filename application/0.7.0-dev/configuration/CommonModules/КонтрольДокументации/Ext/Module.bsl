Функция ПолучитьСостояние(Редакция) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Состояния.Период, Состояния.Регистратор, Состояния.Состояние,
	| Состояния.Проверяющий, Состояния.Передача
	|ИЗ РегистрСведений.СостоянияРедакций.СрезПоследних(, Редакция = &Редакция) КАК Состояния";
	Запрос.УстановитьПараметр("Редакция", Редакция);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Период,Регистратор,Состояние,Проверяющий,Передача",
			Выборка.Период, Выборка.Регистратор, Выборка.Состояние, Выборка.Проверяющий, Выборка.Передача);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Процедура ПроверитьИзменениеРедакции(Объект) Экспорт
	Если Объект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Передача.Ссылка ИЗ Документ.ПередачаНаПроверку КАК Передача
	|ГДЕ Передача.Редакция = &Редакция И Передача.Проведен";
	Запрос.УстановитьПараметр("Редакция", Объект.Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	Прежняя = Объект.Ссылка.ПолучитьОбъект();
	Для Каждого Поле Из СтрРазделить("ДокументПродукта,НомерРедакции,Автор,СсылкаНаТекст,ИдентификаторСодержимого", ",", Ложь) Цикл
		Если Объект[Поле] <> Прежняя[Поле] Тогда
			ВызватьИсключение "Редакция уже передана на проверку. Для изменённого текста создайте новую редакцию.";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьЗаписьПроведённого(Объект, РежимЗаписи, ИменаПолей) Экспорт
	Если Объект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Прежний = Объект.Ссылка.ПолучитьОбъект();
	Если Не Прежний.Проведен Тогда
		Возврат;
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		ВызватьИсключение "Сначала отмените проведение документа. Изменение проведённой операции запрещено.";
	КонецЕсли;
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение
		Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Для Каждого Поле Из СтрРазделить(ИменаПолей, ",", Ложь) Цикл
			Если Объект[Поле] <> Прежний[Поле] Тогда
				Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
					ВызватьИсключение "При отмене проведения не изменяйте реквизиты проведённой операции.";
				КонецЕсли;
				ВызватьИсключение "Для изменения операции сначала отмените её проведение.";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПоследнююОперацию(Объект, Редакция) Экспорт
	// Ищем зависимые события независимо от удаления собственных движений при отмене.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 История.Регистратор
	|ИЗ РегистрСведений.СостоянияРедакций КАК История
	|ГДЕ История.Редакция = &Редакция И История.Период >= &Дата
	| И История.Регистратор <> &Документ";
	Запрос.УстановитьПараметр("Редакция", Редакция);
	Прежний = Объект.Ссылка.ПолучитьОбъект();
	Запрос.УстановитьПараметр("Дата", Прежний.Дата);
	Запрос.УстановитьПараметр("Документ", Объект.Ссылка);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Есть последующая операция по этой редакции. Сначала отмените последнюю операцию.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьПоследующиеПередаче(Передача) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 ЗаписиПроверки.Ссылка ИЗ Документ.РезультатПроверки КАК ЗаписиПроверки
	|ГДЕ ЗаписиПроверки.Передача = &Передача И ЗаписиПроверки.Проведен";
	Запрос.УстановитьПараметр("Передача", Передача);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "По передаче уже есть проведённое решение. Сначала отмените зависимую операцию.";
	КонецЕсли;
КонецПроцедуры

Процедура НачатьПроведение(Объект)
	// Перепроведение заменяет собственные движения в транзакции документа.
	Объект.Движения.СостоянияРедакций.Записывать = Истина;
	Объект.Движения.СостоянияРедакций.Очистить();
	Объект.Движения.СостоянияРедакций.Записать();
КонецПроцедуры

Процедура ПодготовитьДвижение(Объект, Редакция, Состояние, Проверяющий, Передача)
	Движение = Объект.Движения.СостоянияРедакций.Добавить();
	Движение.Период = Объект.Дата;
	Движение.Редакция = Редакция;
	Движение.Состояние = Состояние;
	Движение.Проверяющий = Проверяющий;
	Движение.Передача = Передача;
КонецПроцедуры

Процедура ПровестиПередачу(Объект) Экспорт
	ПроверитьПоследующиеПередаче(Объект.Ссылка);
	НачатьПроведение(Объект);
	Состояние = ПолучитьСостояние(Объект.Редакция);
	Если Состояние <> Неопределено Тогда
		Если Объект.Дата <= Состояние.Период Тогда
			ВызватьИсключение "Дата новой операции должна быть позже предыдущей операции этой редакции.";
		КонецЕсли;
		Если Состояние.Состояние = Перечисления.СостоянияРедакции.НаПроверке Тогда
			ВызватьИсключение "Редакция уже находится на проверке. Дождитесь решения проверяющего.";
		КонецЕсли;
		Если Состояние.Состояние = Перечисления.СостоянияРедакции.Согласована Тогда
			ВызватьИсключение "Редакция уже согласована. Изменённый текст оформите новой редакцией.";
		КонецЕсли;
	КонецЕсли;
	ПодготовитьДвижение(Объект, Объект.Редакция, Перечисления.СостоянияРедакции.НаПроверке,
		Объект.Проверяющий, Объект.Ссылка);
КонецПроцедуры

Процедура ПровестиРешение(Объект) Экспорт
	НачатьПроведение(Объект);
	Если Не Объект.Передача.Проведен Тогда
		ВызватьИсключение "Передача на проверку должна быть проведена.";
	КонецЕсли;
	Если Объект.Проверяющий <> Объект.Передача.Проверяющий Тогда
		ВызватьИсключение "Решение должен оформить проверяющий, назначенный в передаче.";
	КонецЕсли;
	Редакция = Объект.Передача.Редакция;
	Состояние = ПолучитьСостояние(Редакция);
	Если Состояние = Неопределено Тогда
		ВызватьИсключение "Редакция не передана на проверку.";
	КонецЕсли;
	Если Состояние.Состояние <> Перечисления.СостоянияРедакции.НаПроверке
		Или Состояние.Передача <> Объект.Передача Тогда
		ВызватьИсключение "Решение допускается только по текущей незавершённой проверке.";
	КонецЕсли;
	Если Объект.Дата <= Состояние.Период Тогда
		ВызватьИсключение "Дата решения должна быть позже передачи на проверку.";
	КонецЕсли;
	Если Объект.Передача.СсылкаНаТекст <> Редакция.СсылкаНаТекст
		Или Объект.Передача.ИдентификаторСодержимого <> Редакция.ИдентификаторСодержимого Тогда
		ВызватьИсключение "Текст редакции отличается от переданного на проверку. Проверьте редакцию.";
	КонецЕсли;
	Если Объект.Решение = Перечисления.РешенияПроверки.Согласовано Тогда
		Итог = Перечисления.СостоянияРедакции.Согласована;
	Иначе
		Итог = Перечисления.СостоянияРедакции.НаДоработке;
	КонецЕсли;
	ПодготовитьДвижение(Объект, Редакция, Итог, Объект.Проверяющий, Объект.Передача);
КонецПроцедуры

Процедура Убедиться(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция ПробнаяРедакция(Пример)
	Объект = Справочники.РедакцииДокументов.СоздатьЭлемент();
	Объект.Наименование = "Временная редакция для проверки";
	Объект.ДокументПродукта = Пример.Документ;
	Объект.НомерРедакции = "TEST-" + Лев(Строка(Новый УникальныйИдентификатор), 20);
	Объект.Автор = Пример.Автор;
	Объект.СсылкаНаТекст = Пример.Редакция.СсылкаНаТекст;
	Объект.ИдентификаторСодержимого = Пример.Редакция.ИдентификаторСодержимого;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция НоваяПередача(Редакция, Проверяющий, ДатаОперации)
	Объект = Документы.ПередачаНаПроверку.СоздатьДокумент();
	Объект.Дата = ДатаОперации;
	Объект.Редакция = Редакция;
	Объект.Проверяющий = Проверяющий;
	Возврат Объект;
КонецФункции

Функция НовоеРешение(Передача, Проверяющий, Решение, ДатаОперации, Замечание = "")
	Объект = Документы.РезультатПроверки.СоздатьДокумент();
	Объект.Дата = ДатаОперации;
	Объект.Передача = Передача;
	Объект.Проверяющий = Проверяющий;
	Объект.Решение = Решение;
	Объект.Замечание = Замечание;
	Возврат Объект;
КонецФункции

Процедура ПровестиПробныйДокумент(Объект)
	Объект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
КонецПроцедуры

Процедура ПроверитьОтказЗаписи(Объект, Причина, Режим = Неопределено)
	Отклонено = Ложь;
	Попытка
		Если Режим = Неопределено Тогда
			Объект.Записать();
		ИначеЕсли Режим = РежимЗаписиДокумента.Проведение Тогда
			ПровестиПробныйДокумент(Объект);
		Иначе
			Объект.Записать(Режим);
		КонецЕсли;
	Исключение
		Отклонено = СтрНайти(ОписаниеОшибки(), Причина) > 0;
	КонецПопытки;
	Убедиться(Отклонено, "Операция не отклонена по ожидаемой причине: " + Причина);
КонецПроцедуры

Процедура ПроверитьТекущееСостояние(Редакция, Ожидаемое)
	Состояние = ПолучитьСостояние(Редакция);
	Убедиться(Состояние <> Неопределено, "Не записано состояние редакции.");
	Убедиться(Состояние.Состояние = Ожидаемое, "Текущее состояние отличается от ожидаемого.");
КонецПроцедуры

Процедура ВыполнитьПроверкуСогласования(Номер, Пример)
	Редакция = ПробнаяРедакция(Пример);
	НачальнаяДата = ТекущаяДата();
	Передача = НоваяПередача(Редакция, Пример.Проверяющий, НачальнаяДата);
	ПровестиПробныйДокумент(Передача);
	ПроверитьТекущееСостояние(Редакция, Перечисления.СостоянияРедакции.НаПроверке);

	Если Номер = 1 Тогда
		Прочитанная = Передача.Ссылка.ПолучитьОбъект();
		Убедиться(Прочитанная.СсылкаНаТекст = Редакция.СсылкаНаТекст, "Не сохранена ссылка на переданный текст.");
		Убедиться(Прочитанная.ИдентификаторСодержимого = Редакция.ИдентификаторСодержимого, "Не сохранён идентификатор переданного текста.");
		Убедиться(ПолучитьСостояние(Редакция).Передача = Передача.Ссылка, "Состояние не связано с передачей.");
	ИначеЕсли Номер = 2 Тогда
		Повтор = НоваяПередача(Редакция, Пример.Проверяющий, НачальнаяДата + 2);
		ПроверитьОтказЗаписи(Повтор, "уже находится на проверке", РежимЗаписиДокумента.Проведение);
	ИначеЕсли Номер = 3 Тогда
		Решение = НовоеРешение(Передача.Ссылка, Пример.Проверяющий, Перечисления.РешенияПроверки.Согласовано, НачальнаяДата + 1);
		ПровестиПробныйДокумент(Решение);
		ПровестиПробныйДокумент(Решение);
		ПроверитьТекущееСостояние(Редакция, Перечисления.СостоянияРедакции.Согласована);
		Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Число ИЗ РегистрСведений.СостоянияРедакций ГДЕ Редакция = &Редакция");
		Запрос.УстановитьПараметр("Редакция", Редакция);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Убедиться(Выборка.Число = 2, "Перепроведение добавило лишнюю запись в историю.");
		Повтор = НоваяПередача(Редакция, Пример.Проверяющий, НачальнаяДата + 2);
		ПроверитьОтказЗаписи(Повтор, "Редакция уже согласована", РежимЗаписиДокумента.Проведение);
	ИначеЕсли Номер = 4 Тогда
		Решение = НовоеРешение(Передача.Ссылка, Пример.Автор, Перечисления.РешенияПроверки.Согласовано, НачальнаяДата + 1);
		ПроверитьОтказЗаписи(Решение, "назначенный в передаче", РежимЗаписиДокумента.Проведение);
	ИначеЕсли Номер = 5 Тогда
		Решение = НовоеРешение(Передача.Ссылка, Пример.Проверяющий, Перечисления.РешенияПроверки.НаДоработку, НачальнаяДата + 1, "   ");
		ПроверитьОтказЗаписи(Решение, "укажите замечание", РежимЗаписиДокумента.Проведение);
	ИначеЕсли Номер = 6 Тогда
		ДлинноеЗамечание = "";
		Для НомерФрагмента = 1 По 100 Цикл
			ДлинноеЗамечание = ДлинноеЗамечание + "Уточните описание шага 2. ";
		КонецЦикла;
		ДлинноеЗамечание = СокрЛП(ДлинноеЗамечание);
		Убедиться(СтрДлина(ДлинноеЗамечание) > 2000, "Не подготовлено длинное замечание для проверки.");
		Решение = НовоеРешение(Передача.Ссылка, Пример.Проверяющий, Перечисления.РешенияПроверки.НаДоработку, НачальнаяДата + 1, ДлинноеЗамечание);
		ПровестиПробныйДокумент(Решение);
		Убедиться(Решение.Ссылка.Замечание = ДлинноеЗамечание, "Длинное замечание не сохранено полностью.");
		ПроверитьТекущееСостояние(Редакция, Перечисления.СостоянияРедакции.НаДоработке);
		Повтор = НоваяПередача(Редакция, Пример.Проверяющий, НачальнаяДата + 2);
		ПровестиПробныйДокумент(Повтор);
		ПроверитьТекущееСостояние(Редакция, Перечисления.СостоянияРедакции.НаПроверке);
		ПроверитьОтказЗаписи(Решение, "Есть последующая операция", РежимЗаписиДокумента.ОтменаПроведения);
	ИначеЕсли Номер = 7 Тогда
		Решение = НовоеРешение(Передача.Ссылка, Пример.Проверяющий, Перечисления.РешенияПроверки.Согласовано, НачальнаяДата + 1);
		ПровестиПробныйДокумент(Решение);
		Изменённая = Редакция.ПолучитьОбъект();
		Изменённая.ИдентификаторСодержимого = "other-content";
		ПроверитьОтказЗаписи(Изменённая, "создайте новую редакцию");
	ИначеЕсли Номер = 8 Тогда
		Решение = НовоеРешение(Передача.Ссылка, Пример.Проверяющий, Перечисления.РешенияПроверки.Согласовано, НачальнаяДата + 1);
		ПровестиПробныйДокумент(Решение);
		ПроверитьОтказЗаписи(Передача, "отмените зависимую операцию", РежимЗаписиДокумента.ОтменаПроведения);
	ИначеЕсли Номер = 9 Тогда
		Решение = НовоеРешение(Передача.Ссылка, Пример.Проверяющий, Перечисления.РешенияПроверки.Согласовано, НачальнаяДата + 1);
		ПровестиПробныйДокумент(Решение);
		Решение.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ПроверитьТекущееСостояние(Редакция, Перечисления.СостоянияРедакции.НаПроверке);
		Передача.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Убедиться(ПолучитьСостояние(Редакция) = Неопределено, "Отмена передачи оставила состояние в регистре.");
	ИначеЕсли Номер = 10 Тогда
		Решение = НовоеРешение(Передача.Ссылка, Пример.Проверяющий, Перечисления.РешенияПроверки.Согласовано, НачальнаяДата + 1);
		ПровестиПробныйДокумент(Решение);
		НоваяРедакция = ПробнаяРедакция(Пример);
		Убедиться(ПолучитьСостояние(НоваяРедакция) = Неопределено, "Новая редакция унаследовала чужое согласование.");
		ПроверитьТекущееСостояние(Редакция, Перечисления.СостоянияРедакции.Согласована);
	КонецЕсли;
КонецПроцедуры

Процедура ПодготовитьИПроверитьСогласование(КореньПроекта, ХешТекста, ИдентификаторЗапуска) Экспорт
	ПраваДокументации.ТребоватьАдминистратора();
	Если Прав(КореньПроекта, 1) <> "\" Тогда
		КореньПроекта = КореньПроекта + "\";
	КонецЕсли;
	СервисПрототипа.ПодготовитьИПроверитьПрототип(КореньПроекта, ХешТекста, ИдентификаторЗапуска);
	Результат = Новый Структура;
	Результат.Вставить("phase", "milestone_2_runtime");
	Результат.Вставить("version", "0.2.0-dev");
	Результат.Вставить("run_id", ИдентификаторЗапуска);
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	Результат.Вставить("platform_version", ИнформацияОСистеме.ВерсияПриложения);
	Результат.Вставить("status", "FAIL");
	Результат.Вставить("tests", Новый Массив);
	Результат.Вставить("passed_count", 0);
	Результат.Вставить("failed_count", 0);
	Результат.Вставить("demo_sha256", ХешТекста);
	Результат.Вставить("error", "");
	Попытка
		Проверяющий = Справочники.Сотрудники.НайтиПоКоду("DR-REVIEWER");
		Если Проверяющий.Пустая() Тогда
			Сотрудник = Справочники.Сотрудники.СоздатьЭлемент();
			Сотрудник.Код = "DR-REVIEWER";
			Сотрудник.Наименование = "Демонстрационный проверяющий";
			Сотрудник.Записать();
			Проверяющий = Сотрудник.Ссылка;
		КонецЕсли;
		Пример = Новый Структура("Документ,Автор,Редакция,Проверяющий", Справочники.ДокументыПродуктов.НайтиПоКоду("DR-DOC"),
			Справочники.Сотрудники.НайтиПоКоду("DR-AUTHOR"), Справочники.РедакцииДокументов.НайтиПоКоду("DR-REV"), Проверяющий);
		Названия = СтрРазделить("Передача и сохранение идентификатора текста|Повторная передача незавершённой проверки|Согласование и перепроведение без дублирования|Отказ другому выбранному проверяющему|Возврат без замечания|Длинное замечание, возврат и повторная передача|Защита реквизитов переданной редакции|Защита отмены передачи с решением|Последовательная отмена решения и передачи|Отсутствие согласования у новой редакции", "|", Ложь);
		Для Номер = 1 По 10 Цикл
			Проверка = Новый Структура("id,name,status,error", "RV-" + Прав("0" + Строка(Номер), 2), Названия[Номер - 1], "FAIL", "");
			НачатьТранзакцию();
			Попытка
				ВыполнитьПроверкуСогласования(Номер, Пример);
				Проверка.status = "PASS";
				Результат.passed_count = Результат.passed_count + 1;
			Исключение
				Проверка.error = ОписаниеОшибки();
				Результат.failed_count = Результат.failed_count + 1;
			КонецПопытки;
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			Результат.tests.Добавить(Проверка);
		КонецЦикла;
		Если Результат.failed_count = 0 Тогда
			Результат.status = "PASS";
		КонецЕсли;
	Исключение
		Результат.error = ОписаниеОшибки();
		Результат.failed_count = Результат.failed_count + 1;
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
	КонецПопытки;
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(КореньПроекта + ".local\review-run\review-smoke.json");
	ЗаписатьJSON(Запись, Результат);
	Запись.Закрыть();
КонецПроцедуры
