// Права платформы ограничивают виды операций; здесь проверяется сотрудник вошедшего пользователя.
Функция Администратор() Экспорт
	Если РольДоступна("АдминистраторDocRelease") Тогда Возврат Истина; КонецЕсли;
	// При пустом списке пользователей 1С возвращает служебного пользователя с пустым именем.
	// Его права сохраняются до конца начального сеанса, включая создание первого администратора.
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Пользователь = Неопределено Тогда Возврат Ложь; КонецЕсли;
	Возврат (Пользователь.Имя = "")
		И ПравоДоступа("Администрирование", Метаданные);
КонецФункции

Процедура ТребоватьАдминистратора() Экспорт
	Если Не Администратор() Тогда ВызватьИсключение "Доступ DocRelease: требуется роль администратора."; КонецЕсли;
КонецПроцедуры

Процедура ТребоватьРоль(ИмяРоли)
	Если Не Администратор() И Не РольДоступна(ИмяРоли) Тогда
		ВызватьИсключение "Доступ DocRelease: операция недоступна назначенным ролям.";
	КонецЕсли;
КонецПроцедуры

Функция ТекущийСотрудник() Экспорт
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Пользователь = Неопределено Тогда
		ВызватьИсключение "Доступ DocRelease: войдите под пользователем базы.";
	КонецЕсли;
	Если ПустаяСтрока(Пользователь.Имя) Тогда
		ВызватьИсключение "Доступ DocRelease: войдите под пользователем базы.";
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ Сотрудники.Ссылка ИЗ Справочник.Сотрудники КАК Сотрудники
	|ГДЕ Сотрудники.ИдентификаторПользователяИБ = &Идентификатор И НЕ Сотрудники.ПометкаУдаления");
	Запрос.УстановитьПараметр("Идентификатор", Строка(Пользователь.УникальныйИдентификатор));
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() <> 1 Тогда
		ВызватьИсключение "Доступ DocRelease: администратор должен связать пользователя с одним действующим сотрудником.";
	КонецЕсли;
	Возврат Таблица[0].Ссылка;
КонецФункции

Процедура ПроверитьСотрудника(Объект) Экспорт
	ТребоватьАдминистратора();
	Объект.ИмяПользователяИБ = СокрЛП(Объект.ИмяПользователяИБ);
	Объект.ИдентификаторПользователяИБ = "";
	Если Не ЗначениеЗаполнено(Объект.ИмяПользователяИБ) Тогда Возврат; КонецЕсли;
	Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(Объект.ИмяПользователяИБ);
	Если Пользователь = Неопределено Тогда ВызватьИсключение "Не найден пользователь базы с указанным именем."; КонецЕсли;
	Объект.ИдентификаторПользователяИБ = Строка(Пользователь.УникальныйИдентификатор);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Сотрудники.Ссылка ИЗ Справочник.Сотрудники КАК Сотрудники
	|ГДЕ Сотрудники.ИдентификаторПользователяИБ = &Идентификатор И Сотрудники.Ссылка <> &Ссылка");
	Запрос.УстановитьПараметр("Идентификатор", Объект.ИдентификаторПользователяИБ);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "Пользователь базы уже связан с другим сотрудником."; КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЗапись(Объект) Экспорт
	Если Администратор() Тогда Возврат; КонецЕсли;
	Вид = Объект.Метаданные().Имя;
	Если Вид = "Сотрудники" Тогда ТребоватьАдминистратора(); КонецЕсли;
	Если Вид = "ПланКомплекта" Или Вид = "ВыпускКомплекта" Тогда
		ТребоватьРоль("РуководительВыпуска"); Возврат;
	КонецЕсли;
	Если Вид = "РезультатПроверки" Тогда
		ТребоватьРоль("ПроверяющийДокументации"); Сотрудник = ТекущийСотрудник();
		Если Не ЗначениеЗаполнено(Объект.Передача) Или Объект.Передача.Проверяющий <> Сотрудник
			Или Объект.Проверяющий <> Сотрудник Тогда
			ВызватьИсключение "Доступ DocRelease: решение может оформить только назначенный проверяющий под своим пользователем.";
		КонецЕсли;
		Если Не Объект.ЭтоНовый() И Объект.Ссылка.Проверяющий <> Сотрудник Тогда
			ВызватьИсключение "Доступ DocRelease: нельзя изменять чужое решение проверки.";
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ТребоватьРоль("АвторДокументации"); Сотрудник = ТекущийСотрудник();
	Если Вид = "РедакцииДокументов" Тогда
		Если Объект.Автор <> Сотрудник Или (Не Объект.ЭтоНовый() И Объект.Ссылка.Автор <> Сотрудник) Тогда
			ВызватьИсключение "Доступ DocRelease: автор может записывать только свои редакции.";
		КонецЕсли;
	ИначеЕсли Вид = "ПередачаНаПроверку" Тогда
		Если Не ЗначениеЗаполнено(Объект.Редакция) Или Объект.Редакция.Автор <> Сотрудник Тогда
			ВызватьИсключение "Доступ DocRelease: автор может передавать только свои редакции.";
		КонецЕсли;
		Если Не Объект.ЭтоНовый() И Объект.Ссылка.Редакция.Автор <> Сотрудник Тогда
			ВызватьИсключение "Доступ DocRelease: нельзя изменять чужую передачу.";
		КонецЕсли;
	ИначеЕсли Вид <> "Продукты" И Вид <> "ВидыДокументации" И Вид <> "ДокументыПродуктов" Тогда
		ВызватьИсключение "Доступ DocRelease: неизвестная операция записи.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьУдаление(Объект) Экспорт
	// Прикладным ролям физическое удаление не предоставляется.
	ТребоватьАдминистратора();
КонецПроцедуры
