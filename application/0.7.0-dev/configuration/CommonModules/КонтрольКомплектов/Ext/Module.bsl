// Правила записи плана действуют и при программном создании документа.
Процедура ПроверитьПлан(План) Экспорт

	Если Не ЗначениеЗаполнено(План.Продукт) Тогда
		ВызватьИсключение "Укажите продукт плана комплекта.";
	КонецЕсли;
	План.НомерРелиза = СокрЛП(План.НомерРелиза);
	Если ПустаяСтрока(План.НомерРелиза) Тогда
		ВызватьИсключение "Укажите номер релиза.";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(План.Куратор) Тогда
		ВызватьИсключение "Укажите куратора плана комплекта.";
	КонецЕсли;
	Если План.Документы.Количество() = 0 Тогда
		ВызватьИсключение "Добавьте хотя бы один документ в план комплекта.";
	КонецЕсли;

	ВключённыеДокументы = Новый Соответствие;
	Для Каждого СтрокаПлана Из План.Документы Цикл
		Префикс = "Строка " + Строка(СтрокаПлана.НомерСтроки) + ": ";
		Если Не ЗначениеЗаполнено(СтрокаПлана.ДокументПродукта) Тогда
			ВызватьИсключение Префикс + "укажите документ продукта.";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПлана.Ответственный) Тогда
			ВызватьИсключение Префикс + "укажите ответственного.";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПлана.СрокПодготовки) Тогда
			ВызватьИсключение Префикс + "укажите срок подготовки.";
		КонецЕсли;
		Если СтрокаПлана.ДокументПродукта.Продукт <> План.Продукт Тогда
			ВызватьИсключение Префикс + "документ относится к другому продукту.";
		КонецЕсли;
		Если ВключённыеДокументы.Получить(СтрокаПлана.ДокументПродукта) <> Неопределено Тогда
			ВызватьИсключение Префикс + "документ уже включён в план комплекта.";
		КонецЕсли;
		ВключённыеДокументы.Вставить(СтрокаПлана.ДокументПродукта, Истина);
		Если ЗначениеЗаполнено(СтрокаПлана.Редакция) Тогда
			Если СтрокаПлана.Редакция.ДокументПродукта <> СтрокаПлана.ДокументПродукта Тогда
				ВызватьИсключение Префикс + "выбранная редакция относится к другому документу.";
			КонецЕсли;
			Если СтрокаПлана.Редакция.ДокументПродукта.Продукт <> План.Продукт Тогда
				ВызватьИсключение Префикс + "выбранная редакция относится к другому продукту.";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИзменениеПродуктаДокумента(ДокументПродукта) Экспорт
	Если ДокументПродукта.ЭтоНовый() Тогда Возврат; КонецЕсли;
	Прежний = ДокументПродукта.Ссылка.ПолучитьОбъект();
	Если Прежний.Продукт = ДокументПродукта.Продукт Тогда Возврат; КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Состав.Ссылка
	|ИЗ Документ.ПланКомплекта.Документы КАК Состав
	|ГДЕ Состав.ДокументПродукта = &Документ");
	Запрос.УстановитьПараметр("Документ", ДокументПродукта.Ссылка);
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Документ уже используется в плане комплекта. Изменение продукта запрещено.";
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Передачи.Ссылка
	|ИЗ Документ.ПередачаНаПроверку КАК Передачи
	|ГДЕ Передачи.Редакция.ДокументПродукта = &Документ И Передачи.Проведен";
	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Документ уже используется в проверке редакции. Изменение продукта запрещено.";
	КонецЕсли;
КонецПроцедуры
